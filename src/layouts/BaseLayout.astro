---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
	mainClass?: string;
	type?: 'website' | 'article';
}

const {
	title,
	description = 'Portafolio profesional de Raúl David Sánchez — Desarrollador Web Full Stack.',
	image = '/img/raul-david-sanchez.webp',
	mainClass,
	type = 'website',
} = Astro.props;

const siteName = 'Raúl David Sánchez';
const fullTitle = title === 'Inicio' ? `${siteName} · Desarrollador Web` : `${title} · ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://rauldavid.com');
---

<!doctype html>
<html lang="es" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta Tags -->
		<title>{fullTitle}</title>
		<meta name="title" content={fullTitle} />
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, canonicalURL)} />
		<meta property="og:site_name" content={siteName} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={fullTitle} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, canonicalURL)} />

		<!-- Dark Theme Initialization Script (prevents FOUC) -->
		<script is:inline>
			(() => {
				const saved = localStorage.getItem('rd_theme');
				const theme = saved === 'light' ? 'light' : 'dark';
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</head>
	<body>
		<a href="#contenido" class="skip-to-content sr-only focus:not-sr-only">
			Saltar al contenido principal
		</a>
		<Header />
		<main id="contenido" class={mainClass}>
			<slot />
		</main>
		<Footer />

		<!-- Global Theme Toggle Listener -->
		<script is:inline>
			(() => {
				const root = document.documentElement;
				const toggleButtons = document.querySelectorAll('.theme-toggle');

				const updateState = () => {
					const isDark = root.getAttribute('data-theme') !== 'light';
					toggleButtons.forEach((btn) => {
						btn.setAttribute('aria-pressed', String(isDark));
					});
				};

				toggleButtons.forEach((btn) => {
					btn.addEventListener('click', () => {
						const current = root.getAttribute('data-theme');
						const next = current === 'light' ? 'dark' : 'light';
						root.setAttribute('data-theme', next);
						localStorage.setItem('rd_theme', next);
						updateState();
					});
				});

				updateState();
			})();
		</script>
	</body>
</html>

<style>
	.skip-to-content:focus {
		position: fixed;
		top: 1rem;
		left: 1rem;
		z-index: 100;
		padding: 0.75rem 1.25rem;
		background: var(--rd-accent);
		color: #041016;
		font-weight: 700;
		border-radius: var(--rd-radius-md);
		box-shadow: var(--rd-shadow-md);
		text-decoration: none;
	}
</style>
