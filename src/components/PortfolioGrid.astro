---
import type { Project } from '../types/project';
import type { Post } from '../types/post';
import { stripHtml } from '../lib/wordpress';

type DisplayItem = Partial<Project & Post>;

interface Props {
	items: DisplayItem[];
	loadError?: string | null;
	basePath?: string;
	emptyMessage?: string;
}

const {
	items = [],
	loadError = null,
	basePath = '/projects/',
	emptyMessage = 'Aún no hay elementos para mostrar.',
} = Astro.props;

const normalizedBasePath = basePath.endsWith('/') ? basePath : `${basePath}/`;
const isBlog = normalizedBasePath.startsWith('/blog/');
---

{
	loadError ? (
		<p class="error" role="alert">
			No se pudo cargar el contenido: {loadError}
		</p>
	) : items.length === 0 ? (
		<p class="empty">{emptyMessage}</p>
	) : (
		<ul class="grid">
			{items.map((item) => {
				const imageSrc = item.featuredImage?.sourceUrl;
				const cats: string[] = item.categories ?? item.technologies ?? [];
				const href = item.slug ? `${normalizedBasePath}${item.slug}/` : undefined;
				const linkLabel = item.title ? `Ver ${item.title}` : 'Ver detalle';
				const viewLabel = isBlog
					? item.title
						? `Ver post: ${item.title}`
						: 'Ver post'
					: item.title
						? `Proyecto: ${item.title}`
						: 'Proyecto';

				return (
					<li class="card">
						<div class="thumb">
							{imageSrc ? (
								href ? (
									<a href={href} class="thumb-link" aria-label={linkLabel}>
										<img
											src={imageSrc}
											alt={item.featuredImage?.altText || item.title || ''}
											width={item.featuredImage?.width || 600}
											height={item.featuredImage?.height || 400}
											decoding="async"
											loading="lazy"
										/>
									</a>
								) : (
									<img
										src={imageSrc}
										alt={item.featuredImage?.altText || item.title || ''}
										width={item.featuredImage?.width || 600}
										height={item.featuredImage?.height || 400}
										decoding="async"
										loading="lazy"
									/>
								)
							) : (
								<div class="placeholder" aria-hidden="true" />
							)}
						</div>
						<div class="card-body">
							<h3 class="title">{item.title ?? 'Sin título'}</h3>
							{item.excerpt ? (
								<p class="excerpt">{stripHtml(item.excerpt)}</p>
							) : null}
							{cats.length > 0 ? (
								<ul class="tags" aria-label="Categorías">
									{cats.map((c) => (
										<li class="pill pill--sm">{c}</li>
									))}
								</ul>
							) : null}
							<div class="actions">
								{href ? (
									<a class="action action-view" href={href} aria-label={viewLabel}>
										{isBlog ? 'Ver Post' : 'Ver Proyecto'}
									</a>
								) : (
									<span class="action action-view is-disabled" aria-hidden="true">
										{isBlog ? 'Ver Post' : 'Ver Proyecto'}
									</span>
								)}
							</div>
						</div>
					</li>
				);
			})}
		</ul>
	)
}

<style>
	.error {
		background: rgb(220 38 38 / 0.12);
		border: 1px solid rgb(220 38 38 / 0.35);
		color: #fecaca;
		padding: 1rem 1.25rem;
		border-radius: 0.5rem;
	}
	.empty {
		color: var(--rd-text-soft);
		padding: 2rem 0;
	}
	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	@media (max-width: 1024px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 720px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
	.card {
		background: var(--rd-panel);
		border-radius: 1rem;
		overflow: hidden;
		border: 1px solid var(--rd-ink);
		display: flex;
		flex-direction: column;
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
		transition:
			box-shadow 0.18s,
			border-color 0.18s,
			transform 0.18s;
	}
	.card:hover,
	.card:focus-within {
		border-color: color-mix(in srgb, var(--rd-accent) 55%, var(--rd-ink));
		box-shadow:
			0 14px 40px rgba(0, 0, 0, 0.22),
			0 0 0 1px color-mix(in srgb, var(--rd-accent) 35%, transparent);
		transform: translateY(-1px);
	}
	.thumb {
		position: relative;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		background: var(--rd-ink);
	}
	.thumb-link {
		display: block;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.placeholder {
		width: 100%;
		height: 100%;
		background: var(--rd-ink);
	}
	.card-body {
		padding: 1.1rem 1.25rem 1.25rem;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}
	.title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.35;
	}
	.excerpt {
		font-size: 0.9375rem;
		color: var(--rd-text-soft);
		line-height: 1.5;
		margin: 0;
	}
	.tags {
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.actions {
		margin-top: auto;
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
		padding-top: 0.75rem;
	}
</style>
