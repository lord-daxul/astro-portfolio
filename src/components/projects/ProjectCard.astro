---
import type { Project } from '../../types/project';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';

interface Props {
	project: Project;
	basePath?: string;
}

const { project, basePath = '/projects/' } = Astro.props;
const normalizedBasePath = basePath.endsWith('/') ? basePath : `${basePath}/`;
const detailHref = project.slug ? `${normalizedBasePath}${project.slug}/` : undefined;

const img = project.featuredImage;
const imageSrc = img?.sourceUrl;
---

<article class="project-card">
	<div class="project-thumb">
		{
			imageSrc ? (
				detailHref ? (
					<a href={detailHref} class="thumb-link" tabindex="-1" aria-hidden="true">
						<img
							src={imageSrc}
							alt={img?.altText || `Vista previa de ${project.title}`}
							width={img?.width || 600}
							height={img?.height || 380}
							loading="lazy"
							decoding="async"
						/>
					</a>
				) : (
					<img
						src={imageSrc}
						alt={img?.altText || `Vista previa de ${project.title}`}
						width={img?.width || 600}
						height={img?.height || 380}
						loading="lazy"
						decoding="async"
					/>
				)
			) : (
				<div class="placeholder-thumb" aria-hidden="true">
					<span class="placeholder-icon">💻</span>
				</div>
			)
		}
	</div>

	<div class="project-body">
		{
			project.projectDate ? (
				<span class="project-year">{project.projectDate}</span>
			) : null
		}
		<h3 class="project-title">
			{
				detailHref ? (
					<a href={detailHref}>{project.title}</a>
				) : (
					project.title
				)
			}
		</h3>

		{
			project.excerpt ? (
				<p class="project-excerpt">{project.excerpt}</p>
			) : null
		}

		{
			project.technologies?.length > 0 ? (
				<div class="project-tags" aria-label="Tecnologías utilizadas">
					{project.technologies.slice(0, 5).map((tech) => (
						<Badge text={tech} variant="default" />
					))}
				</div>
			) : null
		}

		<div class="project-actions">
			{
				detailHref ? (
					<Button href={detailHref} variant="primary" aria-label={`Ver caso de estudio de ${project.title}`}>
						Ver Proyecto
					</Button>
				) : null
			}
			{
				project.projectUrl ? (
					<Button href={project.projectUrl} variant="secondary" target="_blank" aria-label={`Visitar sitio de ${project.title}`}>
						Demo
					</Button>
				) : null
			}
		</div>
	</div>
</article>

<style>
	.project-card {
		background-color: var(--rd-panel);
		border: 1px solid var(--rd-ink);
		border-radius: var(--rd-radius-lg);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-shadow: var(--rd-shadow-sm);
		transition: all 0.2s ease;
	}

	.project-card:hover {
		border-color: color-mix(in srgb, var(--rd-accent) 50%, var(--rd-ink));
		transform: translateY(-2px);
		box-shadow: var(--rd-shadow-md);
	}

	.project-thumb {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--rd-ink-subtle);
	}

	.thumb-link {
		display: block;
		height: 100%;
	}

	.project-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.3s ease;
	}

	.project-card:hover .project-thumb img {
		transform: scale(1.03);
	}

	.placeholder-thumb {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 2.5rem;
		background: var(--rd-ink-subtle);
	}

	.project-body {
		padding: 1.5rem;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.project-year {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--rd-accent);
		margin-bottom: 0.35rem;
	}

	.project-title {
		font-size: 1.25rem;
		font-weight: 800;
		margin: 0 0 0.5rem;
		line-height: 1.3;
	}

	.project-title a {
		color: var(--rd-text);
		text-decoration: none;
	}

	.project-title a:hover {
		color: var(--rd-accent);
	}

	.project-excerpt {
		font-size: 0.9375rem;
		color: var(--rd-text-soft);
		margin: 0 0 1.25rem;
		line-height: 1.55;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1.5rem;
	}

	.project-actions {
		margin-top: auto;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		padding-top: 1rem;
		border-top: 1px solid var(--rd-ink-subtle);
	}
</style>
