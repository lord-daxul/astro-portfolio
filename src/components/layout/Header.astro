---
import ThemeToggle from '../ui/ThemeToggle.astro';

const navLinks = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Proyectos', href: '/projects/' },
	{ label: 'Experiencia', href: '/experience/' },
	{ label: 'CV', href: '/cv/' },
	{ label: 'Blog', href: '/blog/' },
	{ label: 'Contacto', href: '/contacto/' },
];

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => {
	if (href === '/') return pathname === '/';
	return pathname.startsWith(href);
};
---

<header class="site-header">
	<div class="header-container">
		<a class="site-brand" href="/" aria-label="Ir a inicio">
			<span class="brand-text">Raúl David</span>
			<span class="brand-badge">Portfolio</span>
		</a>

		<nav class="site-nav" aria-label="Navegación principal">
			<ul class="nav-list">
				{
					navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class={`nav-link ${isCurrent(link.href) ? 'is-active' : ''}`}
								aria-current={isCurrent(link.href) ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="header-actions">
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.site-header {
		background-color: color-mix(in srgb, var(--rd-panel) 85%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--rd-ink);
		position: sticky;
		top: 0;
		z-index: 50;
	}

	.header-container {
		max-width: 72rem;
		margin-inline: auto;
		padding: 0.85rem clamp(1rem, 4vw, 3rem);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.site-brand {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--rd-text);
	}

	.site-brand:hover {
		text-decoration: none;
	}

	.brand-text {
		font-weight: 800;
		font-size: 1.15rem;
		letter-spacing: -0.025em;
	}

	.brand-badge {
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.15rem 0.45rem;
		border-radius: var(--rd-radius-sm);
		background: var(--rd-ink-subtle);
		border: 1px solid var(--rd-ink);
		color: var(--rd-accent);
	}

	.site-nav {
		display: flex;
	}

	.nav-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav-link {
		color: var(--rd-text-soft);
		font-weight: 600;
		font-size: 0.9375rem;
		padding: 0.4rem 0.75rem;
		border-radius: var(--rd-radius-md);
		text-decoration: none;
		transition: all 0.15s ease;
	}

	.nav-link:hover {
		color: var(--rd-text);
		background: var(--rd-ink-subtle);
		text-decoration: none;
	}

	.nav-link.is-active {
		color: var(--rd-accent);
		background: var(--rd-ink-subtle);
		border: 1px solid color-mix(in srgb, var(--rd-accent) 25%, transparent);
	}

	.header-actions {
		display: flex;
		align-items: center;
	}

	@media (max-width: 768px) {
		.header-container {
			flex-wrap: wrap;
			padding-block: 0.75rem;
		}

		.nav-list {
			gap: 0.25rem;
			overflow-x: auto;
			padding-bottom: 0.25rem;
		}

		.nav-link {
			font-size: 0.875rem;
			padding: 0.35rem 0.5rem;
		}
	}
</style>
