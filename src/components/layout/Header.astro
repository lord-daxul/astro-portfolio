---
const navLinks = [
	{ label: 'Inicio', href: '/' },
	{ label: 'Stack', href: '/stack/' },
	{ label: 'Portfolio', href: '/projects/' },
	{ label: 'Blog', href: '/blog/' },
	{ label: 'Contacto', href: '/contacto/' },
];

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => {
	if (href === '/') return pathname === '/' || pathname === '';
	return pathname.startsWith(href);
};
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-[#0b1020]/90 backdrop-blur-md border-b border-white/5 shadow-xl shadow-black/20">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex items-center justify-between h-16 md:h-20">
			<!-- Logo -->
			<a href="/" class="text-xl font-display font-bold tracking-tight site-logo">
				<span class="text-white site-logo-name">Daxul</span><span class="text-cyan-400">folio</span>
			</a>

			<!-- Desktop Navigation -->
			<nav class="hidden md:flex items-center gap-1" aria-label="Navegación principal">
				{
					navLinks.map((link) => (
						<a
							href={link.href}
							class={`px-4 py-2 text-sm font-medium rounded-lg transition-colors duration-200 ${
								isCurrent(link.href)
									? 'text-cyan-400 bg-cyan-500/10 font-semibold'
									: 'text-white/70 hover:text-cyan-400 hover:bg-white/5'
							}`}
							aria-current={isCurrent(link.href) ? 'page' : undefined}
						>
							{link.label}
						</a>
					))
				}
			</nav>

			<!-- Right Actions (Theme toggle + CV button + Mobile toggle) -->
			<div class="flex items-center gap-2">
				<button
					id="global-theme-toggle-btn"
					class="p-2 rounded-lg text-white/60 hover:text-cyan-400 hover:bg-white/5 transition-all"
					aria-label="Alternar modo oscuro y claro"
				>
					<svg id="sun-icon-global" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
					<svg id="moon-icon-global" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
				</button>

				<a
					href="/cv/"
					class="flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-semibold bg-[#2979FF] text-white hover:bg-[#2979FF]/80 transition-all shadow-lg shadow-[#2979FF]/20"
				>
					Ver CV
				</a>

				<button
					id="global-mobile-menu-btn"
					class="md:hidden p-2 rounded-lg text-white/60 hover:text-white hover:bg-white/5 transition-all"
					aria-label="Abrir menú"
				>
					<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
				</button>
			</div>
		</div>
	</div>

	<!-- Mobile Menu Dropdown -->
	<div id="global-mobile-menu" class="hidden md:hidden backdrop-blur-md border-t px-4 pb-4 bg-[#0b1020]/95 border-white/10">
		{
			navLinks.map((link) => (
				<a
					href={link.href}
					class={`block py-3 text-sm font-medium border-b border-white/5 ${
						isCurrent(link.href) ? 'text-cyan-400 font-semibold' : 'text-white/70 hover:text-cyan-400'
					}`}
				>
					{link.label}
				</a>
			))
		}
		<a href="/cv/" class="block py-3 text-sm font-semibold text-cyan-400">
			Ver CV Completo →
		</a>
	</div>
</header>

<script is:inline>
	(() => {
		const mobileBtn = document.getElementById('global-mobile-menu-btn');
		const mobileMenu = document.getElementById('global-mobile-menu');
		const themeBtn = document.getElementById('global-theme-toggle-btn');
		const sunIcon = document.getElementById('sun-icon-global');
		const moonIcon = document.getElementById('moon-icon-global');

		mobileBtn?.addEventListener('click', () => {
			mobileMenu?.classList.toggle('hidden');
		});

		const updateIcons = () => {
			const isLight = document.documentElement.classList.contains('light') || document.body?.classList.contains('light');
			if (isLight) {
				sunIcon?.classList.add('hidden');
				moonIcon?.classList.remove('hidden');
			} else {
				sunIcon?.classList.remove('hidden');
				moonIcon?.classList.add('hidden');
			}
		};

		themeBtn?.addEventListener('click', () => {
			document.body?.classList.toggle('light');
			document.documentElement.classList.toggle('light');
			const isLight = document.body?.classList.contains('light');
			localStorage.setItem('theme', isLight ? 'light' : 'dark');
			updateIcons();
		});

		updateIcons();
	})();
</script>
