---
interface Props {
	title: string;
	subtitle?: string;
	align?: 'left' | 'center';
	id?: string;
	class?: string;
}

const { title, subtitle, align = 'center', id, class: className = '' } = Astro.props;
---

<header class={`section-header section-header--${align} ${className}`}>
	<h2 id={id} class="section-title">{title}</h2>
	{subtitle ? <p class="section-subtitle">{subtitle}</p> : null}
</header>

<style>
	.section-header {
		margin-bottom: 2.25rem;
	}

	.section-header--center {
		text-align: center;
		max-width: 44rem;
		margin-inline: auto;
	}

	.section-header--left {
		text-align: left;
	}

	.section-title {
		font-size: clamp(1.75rem, 3.5vw, 2.25rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		margin: 0;
	}

	.section-subtitle {
		margin-top: 0.5rem;
		margin-bottom: 0;
		font-size: 1.0625rem;
		color: var(--rd-text-soft);
	}
</style>
