---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
import ProjectGrid from '../components/projects/ProjectGrid.astro';
import ExperienceTimeline from '../components/experience/ExperienceTimeline.astro';
import { getProjects, getExperiences } from '../lib/wordpress';
import type { Experience } from '../types/experience';

const specialtiesAndSkills = [
	{
		title: 'Desarrollo de WebApps & Full Stack',
		description: 'Ingeniería de aplicaciones web modernas, reactivas y ultrarrápidas utilizando Astro, React, Next.js, TypeScript y Tailwind CSS.',
		tags: ['WebApps', 'Astro', 'React', 'Next.js', 'TypeScript', 'Node.js', 'Tailwind CSS'],
		icon: '⚡',
	},
	{
		title: 'Desarrollo Móvil (iOS & Android)',
		description: 'Creación de aplicaciones móviles multiplataforma nativas y fluidas, con sincronización de datos en tiempo real y almacenamiento offline.',
		tags: ['iOS', 'Android', 'React Native', 'Expo', 'Cross-Platform', 'Mobile APIs'],
		icon: '📱',
	},
	{
		title: 'Vibe Coding & AI Engineering',
		description: 'Desarrollo acelerado mediante agentes autónomos de IA, prototipado instantáneo de ideas a producción, integración de LLMs y automatizaciones.',
		tags: ['Vibe Coding', 'AI Agents', 'LLMs', 'Prompt Engineering', 'Automatización'],
		icon: '🧠',
	},
	{
		title: 'WordPress Headless & CMS Moderno',
		description: 'Arquitecturas desacopladas con WPGraphQL y ACF Pro para entregar paneles editoriales intuitivos y frontends de máxima velocidad.',
		tags: ['WordPress Headless', 'WPGraphQL', 'ACF Pro', 'PHP', 'APIs REST'],
		icon: '🛠',
	},
	{
		title: 'Cloud, Edge & Serverless',
		description: 'Despliegues globales en el Edge con Cloudflare Workers, microservicios serverless, latencia ultrabaja y entrega de emails con Resend.',
		tags: ['Cloudflare Workers', 'Edge Computing', 'Wrangler', 'Serverless', 'Resend API'],
		icon: '☁',
	},
	{
		title: 'Rendimiento Extremo & Accesibilidad (a11y)',
		description: 'Optimización obsesiva de Core Web Vitals (LCP < 1.2s), navegación por teclado, contraste estricto y cumplimiento WCAG 2.1 AA.',
		tags: ['Core Web Vitals', 'LCP < 1.2s', 'WCAG 2.1 AA', 'SEO Técnico'],
		icon: '🎯',
	},
];

const fallbackExperience: Experience[] = [
	{
		id: 'exp-1',
		title: 'Senior Full Stack & Headless Architect',
		role: 'Senior Full Stack & Headless Architect',
		company: 'PangeaTech',
		location: 'Bogotá, Colombia (Remoto)',
		startDate: '2023',
		endDate: '2025',
		isCurrent: false,
		description: 'Liderazgo en la modernización y desarrollo de plataformas web de alto tráfico. Migración a arquitecturas desacopladas con Astro y WordPress Headless vía WPGraphQL, reduciendo tiempos de carga en un 65% y desplegando en Cloudflare Workers.',
		technologies: ['Astro', 'WordPress Headless', 'WPGraphQL', 'TypeScript', 'Cloudflare Workers', 'Tailwind CSS'],
	},
	{
		id: 'exp-2',
		title: 'Senior WordPress & Frontend Developer',
		role: 'Senior WordPress & Frontend Developer',
		company: 'Proyectos Corporativos & Consultoría',
		location: 'Bogotá, Colombia (Remoto)',
		startDate: '2021',
		endDate: '2023',
		isCurrent: false,
		description: 'Desarrollo de themes a medida basados en ACF Pro y Gutenberg, WebApps reactivas y APIs personalizadas, asegurando puntuaciones perfectas en Core Web Vitals.',
		technologies: ['WordPress', 'PHP', 'React', 'ACF Pro', 'REST API', 'SEO Técnico'],
	},
	{
		id: 'exp-3',
		title: 'Desarrollador Web & Mobile Freelance',
		role: 'Desarrollador Web & Mobile Freelance',
		company: 'Estudio Independiente',
		location: 'Bogotá, Colombia',
		startDate: '2016',
		endDate: '2021',
		isCurrent: false,
		description: 'Diseño e implementación de más de 30 soluciones web y aplicaciones móviles para clientes internacionales en comercio electrónico, SaaS y medios digitales.',
		technologies: ['React Native', 'JavaScript', 'HTML5/CSS3', 'WordPress', 'MySQL'],
	},
];

let projects = await getProjects(6).catch(() => []);
let experiences = await getExperiences().catch(() => []);

if (experiences.length === 0) {
	experiences = fallbackExperience;
}
---

<BaseLayout
	title="Inicio"
	description="Raúl David Sánchez — Senior Full Stack Developer en Bogotá, Colombia. Especialista en WebApps de alto rendimiento (Astro, React), WordPress Headless (WPGraphQL), aplicaciones móviles (iOS/Android) y AI Vibe Coding."
	keywords={[
		'Desarrollador Web Bogotá',
		'Desarrollador Full Stack Colombia',
		'Desarrollo WebApps Astro React',
		'Desarrollador WordPress Headless Bogotá',
		'WPGraphQL Cloudflare Workers',
		'Desarrollador Mobile iOS Android React Native Colombia',
		'AI Vibe Coding Developer',
		'Ingeniero de Software Bogotá',
	]}
>
	<!-- Hero Section -->
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-body">
			<span class="hero-badge">📍 Bogotá, Colombia · Senior Full Stack & AI Vibe Coder</span>
			<h1 id="hero-title" class="hero-heading">
				Hola, soy <span class="highlight">Raúl David Sánchez</span>.<br />
				Desarrollador Full Stack & Mobile.
			</h1>
			<p class="hero-lead">
				Especializado en construir <strong>WebApps ultrarrápidas</strong>, arquitecturas <strong>WordPress Headless</strong> desplegadas en Cloudflare Workers y aplicaciones móviles para <strong>iOS & Android</strong>.
			</p>
			<p class="hero-sublead">
				Acelero el ciclo de desarrollo desde la concepción hasta producción combinando arquitectura de software de clase mundial y <strong>Vibe Coding</strong> asistido por agentes de inteligencia artificial.
			</p>
			<div class="hero-cta">
				<Button href="/projects/" variant="primary">
					Explorar Proyectos
				</Button>
				<Button href="/cv/" variant="secondary">
					📄 Ver / Descargar CV
				</Button>
				<Button href="/contacto/" variant="ghost">
					Contáctame en Bogotá →
				</Button>
			</div>
		</div>

		<div class="hero-avatar">
			<div class="avatar-frame">
				<img
					src="/img/raul-david-sanchez.webp"
					alt="Fotografía de Raúl David Sánchez — Desarrollador Full Stack en Bogotá"
					width="380"
					height="380"
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</div>
		</div>
	</section>

	<!-- Skills Section -->
	<section class="section" aria-labelledby="skills-heading">
		<SectionHeader
			id="skills-heading"
			title="Especialidades & Habilidades Técnicas"
			subtitle="Disciplinas de ingeniería, tecnologías y soluciones en las que aporto máximo valor competitivo."
		/>
		<div class="skills-grid">
			{
				specialtiesAndSkills.map((skill) => (
					<article class="skill-card">
						<div class="skill-top">
							<span class="skill-icon" aria-hidden="true">{skill.icon}</span>
							<h3 class="skill-title">{skill.title}</h3>
						</div>
						<p class="skill-desc">{skill.description}</p>
						<div class="skill-tags">
							{skill.tags.map((t) => (
								<span class="pill pill--sm">{t}</span>
							))}
						</div>
					</article>
				))
			}
		</div>
	</section>

	<!-- Projects Preview Section -->
	<section class="section" aria-labelledby="projects-heading">
		<SectionHeader
			id="projects-heading"
			title="Proyectos Destacados en WebApps & Headless"
			subtitle="Casos de estudio recientes, plataformas web en producción y soluciones a medida."
		/>
		<ProjectGrid
			projects={projects}
			basePath="/projects/"
			emptyMessage="No se pudieron cargar los proyectos de WordPress en este momento."
		/>
		<div class="section-footer-action">
			<Button href="/projects/" variant="secondary">
				Explorar todos los proyectos →
			</Button>
		</div>
	</section>

	<!-- Experience Section -->
	<section class="section" aria-labelledby="experience-heading">
		<SectionHeader
			id="experience-heading"
			title="Trayectoria Profesional en Ingeniería de Software"
			subtitle="Experiencia liderando arquitecturas digitales para clientes en Colombia y el mercado internacional."
		/>
		<div class="experience-container">
			<ExperienceTimeline items={experiences} />
		</div>
		<div class="section-footer-action">
			<Button href="/cv/" variant="secondary">
				Ver CV completo detallado →
			</Button>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		align-items: center;
		gap: 3rem;
		padding-block: clamp(2rem, 6vw, 4.5rem);
		border-bottom: 1px solid var(--rd-ink);
		margin-bottom: 3.5rem;
	}

	.hero-badge {
		display: inline-block;
		font-size: 0.8125rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--rd-accent);
		margin-bottom: 0.75rem;
	}

	.hero-heading {
		font-size: clamp(2.25rem, 4.5vw, 3.25rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.035em;
		margin: 0 0 1.25rem;
	}

	.highlight {
		color: var(--rd-accent);
	}

	.hero-lead {
		font-size: 1.15rem;
		color: var(--rd-text);
		line-height: 1.6;
		margin: 0 0 0.75rem;
		max-width: 38rem;
	}

	.hero-sublead {
		font-size: 1rem;
		color: var(--rd-text-soft);
		line-height: 1.6;
		margin: 0 0 2rem;
		max-width: 38rem;
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
	}

	.hero-avatar {
		display: flex;
		justify-content: center;
	}

	.avatar-frame {
		position: relative;
		width: min(20rem, 100%);
		aspect-ratio: 1;
		border-radius: var(--rd-radius-lg);
		overflow: hidden;
		border: 2px solid var(--rd-ink);
		box-shadow: var(--rd-shadow-lg);
		background: var(--rd-panel);
	}

	.avatar-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		display: block;
	}

	.section {
		padding-bottom: 4rem;
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
		gap: 1.5rem;
	}

	.skill-card {
		background: var(--rd-panel);
		border: 1px solid var(--rd-ink);
		border-radius: var(--rd-radius-lg);
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		box-shadow: var(--rd-shadow-sm);
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.skill-card:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--rd-accent) 45%, var(--rd-ink));
		box-shadow: var(--rd-shadow-md);
	}

	.skill-top {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		margin-bottom: 0.75rem;
	}

	.skill-icon {
		font-size: 1.5rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: var(--rd-radius-md);
		background: var(--rd-ink-subtle);
		border: 1px solid var(--rd-ink);
	}

	.skill-title {
		font-size: 1.125rem;
		font-weight: 800;
		margin: 0;
		letter-spacing: -0.02em;
	}

	.skill-desc {
		font-size: 0.9375rem;
		color: var(--rd-text-soft);
		margin: 0 0 1.25rem;
		line-height: 1.55;
	}

	.skill-tags {
		margin-top: auto;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.section-footer-action {
		text-align: center;
		margin-top: 2.5rem;
	}

	.experience-container {
		max-width: 48rem;
		margin-inline: auto;
	}

	@media (max-width: 860px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2rem;
			text-align: center;
		}

		.hero-lead,
		.hero-sublead {
			margin-inline: auto;
		}

		.hero-cta {
			justify-content: center;
		}

		.avatar-frame {
			width: min(15rem, 70%);
		}
	}
</style>
