---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/ui/Button.astro';
import ProjectGrid from '../components/projects/ProjectGrid.astro';
import ExperienceTimeline from '../components/experience/ExperienceTimeline.astro';
import { getProjects, getExperiences } from '../lib/wordpress';
import type { Experience } from '../types/experience';

const fallbackSkills = [
	{
		title: 'Desarrollo Frontend',
		description: 'Interfaces de usuario modernas, rápidas y accesibles con Astro, React, TypeScript y Tailwind CSS.',
		tags: ['Astro', 'TypeScript', 'Tailwind CSS', 'React', 'Next.js'],
		icon: '⚡',
	},
	{
		title: 'WordPress Headless & Full Stack',
		description: 'Arquitecturas desacopladas con WPGraphQL, desarrollo de themes a medida, plugins y optimización de rendimiento.',
		tags: ['WordPress', 'WPGraphQL', 'ACF Pro', 'PHP', 'APIs'],
		icon: '🛠',
	},
	{
		title: 'Desarrollo Backend & Cloud',
		description: 'APIs escalables, funciones serverless y despliegues en el Edge con Cloudflare Workers y Node.js.',
		tags: ['Cloudflare Workers', 'Node.js', 'PostgreSQL', 'GraphQL', 'Resend'],
		icon: '☁',
	},
	{
		title: 'Rendimiento & Accesibilidad (a11y)',
		description: 'Enfoque en Core Web Vitals, HTML semántico, navegación por teclado y cumplimiento WCAG 2.1 AA.',
		tags: ['Core Web Vitals', 'LCP Optimization', 'WCAG AA', 'SEO'],
		icon: '🎯',
	},
];

const fallbackExperience: Experience[] = [
	{
		id: 'exp-1',
		title: 'WebMaster & Full Stack Developer',
		role: 'WebMaster & Full Stack Developer',
		company: 'PangeaTech',
		location: 'Remoto',
		startDate: '2023',
		endDate: '2025',
		isCurrent: false,
		description: 'Desarrollo y mantenimiento de plataformas web de alto tráfico, optimización de velocidad de carga y modernización del stack tecnológico.',
		technologies: ['WordPress', 'PHP', 'JavaScript', 'Tailwind CSS', 'Cloudflare'],
	},
	{
		id: 'exp-2',
		title: 'Senior WordPress Developer',
		role: 'Senior WordPress Developer',
		company: 'Proyectos Corporativos',
		location: 'Remoto',
		startDate: '2021',
		endDate: '2023',
		isCurrent: false,
		description: 'Construcción de arquitecturas headless con WordPress, themes a medida con ACF Pro y conectividad API.',
		technologies: ['WordPress Headless', 'WPGraphQL', 'React', 'ACF Pro'],
	},
	{
		id: 'exp-3',
		title: 'Desarrollador Freelance',
		role: 'Desarrollador Web Freelance',
		company: 'Independiente',
		location: 'Remoto',
		startDate: '2016',
		endDate: '2021',
		isCurrent: false,
		description: 'Diseño e implementación de sitios web corporativos, tiendas e-commerce y soluciones personalizadas para clientes internacionales.',
		technologies: ['JavaScript', 'HTML5/CSS3', 'WordPress', 'SEO'],
	},
];

let projects = await getProjects(6).catch(() => []);
let experiences = await getExperiences().catch(() => []);

if (experiences.length === 0) {
	experiences = fallbackExperience;
}
---

<BaseLayout title="Inicio" description="Portafolio profesional de Raúl David Sánchez — Desarrollador Full Stack & WordPress Headless.">
	<!-- Hero Section -->
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-body">
			<span class="hero-badge">Desarrollador Web Full Stack</span>
			<h1 id="hero-title" class="hero-heading">
				Hola, soy <span class="highlight">Raúl David</span>.
			</h1>
			<p class="hero-description">
				Especializado en construir aplicaciones web ultrarrápidas, accesibles y elegantes combinando 
				<strong>Astro</strong>, <strong>WordPress Headless</strong> y <strong>Cloudflare</strong>.
			</p>
			<div class="hero-cta">
				<Button href="/projects/" variant="primary">
					Ver Proyectos
				</Button>
				<Button href="/contacto/" variant="secondary">
					Hablemos
				</Button>
			</div>
		</div>

		<div class="hero-avatar">
			<div class="avatar-frame">
				<img
					src="/img/raul-david-sanchez.webp"
					alt="Fotografía de Raúl David Sánchez"
					width="380"
					height="380"
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			</div>
		</div>
	</section>

	<!-- Skills Section -->
	<section class="section" aria-labelledby="skills-heading">
		<SectionHeader
			id="skills-heading"
			title="Especialidades & Habilidades"
			subtitle="Stack técnico y disciplinas donde aporto mayor valor."
		/>
		<div class="skills-grid">
			{
				fallbackSkills.map((skill) => (
					<article class="skill-card">
						<div class="skill-icon" aria-hidden="true">{skill.icon}</div>
						<h3 class="skill-title">{skill.title}</h3>
						<p class="skill-desc">{skill.description}</p>
						<div class="skill-tags">
							{skill.tags.map((t) => (
								<span class="pill">{t}</span>
							))}
						</div>
					</article>
				))
			}
		</div>
	</section>

	<!-- Projects Preview Section -->
	<section class="section" aria-labelledby="projects-heading">
		<SectionHeader
			id="projects-heading"
			title="Proyectos Destacados"
			subtitle="Selección de trabajos recientes y desarrollos destacados."
		/>
		<ProjectGrid
			projects={projects}
			basePath="/projects/"
			emptyMessage="No se pudieron cargar los proyectos de WordPress en este momento."
		/>
		<div class="section-footer-action">
			<Button href="/projects/" variant="secondary">
				Explorar todos los proyectos →
			</Button>
		</div>
	</section>

	<!-- Experience Section -->
	<section class="section" aria-labelledby="experience-heading">
		<SectionHeader
			id="experience-heading"
			title="Trayectoria Profesional"
			subtitle="Resumen de mi experiencia y roles desempeñados."
		/>
		<div class="experience-container">
			<ExperienceTimeline items={experiences} />
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		align-items: center;
		gap: 3rem;
		padding-block: clamp(2rem, 6vw, 4.5rem);
		border-bottom: 1px solid var(--rd-ink);
		margin-bottom: 3.5rem;
	}

	.hero-badge {
		display: inline-block;
		font-size: 0.8125rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--rd-accent);
		margin-bottom: 0.75rem;
	}

	.hero-heading {
		font-size: clamp(2.5rem, 5vw, 3.5rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.035em;
		margin: 0 0 1.25rem;
	}

	.highlight {
		color: var(--rd-accent);
	}

	.hero-description {
		font-size: 1.15rem;
		color: var(--rd-text-soft);
		line-height: 1.6;
		margin: 0 0 2rem;
		max-width: 36rem;
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.hero-avatar {
		display: flex;
		justify-content: center;
	}

	.avatar-frame {
		position: relative;
		width: min(20rem, 100%);
		aspect-ratio: 1;
		border-radius: var(--rd-radius-lg);
		overflow: hidden;
		border: 2px solid var(--rd-ink);
		box-shadow: var(--rd-shadow-lg);
		background: var(--rd-panel);
	}

	.avatar-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		display: block;
	}

	.section {
		padding-bottom: 4rem;
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		gap: 1.5rem;
	}

	.skill-card {
		background: var(--rd-panel);
		border: 1px solid var(--rd-ink);
		border-radius: var(--rd-radius-lg);
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		box-shadow: var(--rd-shadow-sm);
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.skill-card:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--rd-accent) 40%, var(--rd-ink));
	}

	.skill-icon {
		font-size: 1.75rem;
		margin-bottom: 0.75rem;
	}

	.skill-title {
		font-size: 1.15rem;
		font-weight: 700;
		margin: 0 0 0.5rem;
	}

	.skill-desc {
		font-size: 0.9375rem;
		color: var(--rd-text-soft);
		margin: 0 0 1.25rem;
		line-height: 1.5;
	}

	.skill-tags {
		margin-top: auto;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.section-footer-action {
		text-align: center;
		margin-top: 2.5rem;
	}

	.experience-container {
		max-width: 48rem;
		margin-inline: auto;
	}

	@media (max-width: 860px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2rem;
			text-align: center;
		}

		.hero-description {
			margin-inline: auto;
		}

		.hero-cta {
			justify-content: center;
		}

		.avatar-frame {
			width: min(15rem, 70%);
		}
	}
</style>
