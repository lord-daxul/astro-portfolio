---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Contacto & Propuestas"
	description="Contacta a Raúl David Sánchez en Bogotá, Colombia para desarrollo de WebApps, aplicaciones móviles (iOS/Android), WordPress Headless o consultoría técnica."
	keywords={[
		'Contratar Desarrollador Web Bogotá',
		'Desarrollador Full Stack Colombia',
		'Consultoría WordPress Headless',
		'Desarrollo de Software Bogotá',
		'Raúl David Sánchez Contacto',
	]}
>
	<!-- Banner -->
	<section class="relative py-20 bg-[#0b1020] overflow-hidden">
		<div class="absolute inset-0 grid-bg opacity-40 pointer-events-none"></div>
		<div class="absolute inset-0 hero-glow pointer-events-none"></div>

		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<span class="text-xs font-bold tracking-[0.2em] text-cyan-400 uppercase">Hablemos</span>
			<h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold mt-3 text-white">
				Contacto & <span class="gradient-text">Propuestas</span>
			</h1>
			<p class="text-white/60 max-w-2xl mx-auto text-base sm:text-lg mt-4 leading-relaxed">
				¿Tienes un proyecto en mente, necesitas una WebApp de alto rendimiento o una consultoría técnica desde Bogotá? Escríbeme.
			</p>
		</div>
	</section>

	<!-- Contact Section -->
	<section class="py-20 bg-[#0d1526] relative">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-5 gap-10 items-start">
				<!-- Left Column: Info -->
				<div class="lg:col-span-2 space-y-6">
					<div class="card-dark p-6 sm:p-8 space-y-6">
						<h2 class="font-display font-bold text-xl text-white border-b border-white/5 pb-3">
							Canales Directos
						</h2>

						<div class="space-y-4">
							<div class="flex items-center gap-3.5 text-white/70">
								<div class="p-3 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-lg">
									✉️
								</div>
								<div>
									<div class="text-xs text-white/40 mb-0.5 uppercase tracking-wider">Email</div>
									<a href="mailto:contacto@rauldavid.com" class="text-sm font-semibold text-white hover:text-cyan-400">
										contacto@rauldavid.com
									</a>
								</div>
							</div>

							<div class="flex items-center gap-3.5 text-white/70">
								<div class="p-3 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-lg">
									📍
								</div>
								<div>
									<div class="text-xs text-white/40 mb-0.5 uppercase tracking-wider">Ubicación</div>
									<div class="text-sm font-semibold text-white">Bogotá, Colombia 🇨🇴</div>
								</div>
							</div>
						</div>

						<div class="pt-2">
							<p class="text-xs text-white/40 mb-3 uppercase tracking-widest">Redes Profesionales</p>
							<div class="flex items-center gap-3">
								<a
									href="https://github.com/daxul"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="GitHub"
									class="p-3 rounded-xl border border-white/10 text-white/50 hover:text-white hover:border-cyan-400/40 hover:bg-white/5 transition-all"
								>
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
								</a>
								<a
									href="https://linkedin.com"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="LinkedIn"
									class="p-3 rounded-xl border border-white/10 text-white/50 hover:text-blue-400 hover:border-cyan-400/40 hover:bg-white/5 transition-all"
								>
									<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
								</a>
							</div>
						</div>
					</div>

					<div class="card-dark p-5 border-cyan-500/20 bg-cyan-500/5">
						<div class="flex items-center gap-2 mb-1">
							<span class="w-2.5 h-2.5 rounded-full bg-green-400 animate-pulse"></span>
							<span class="text-sm font-bold text-white">Disponible para nuevos proyectos</span>
						</div>
						<p class="text-xs text-white/50 m-0">Tiempo de respuesta habitual: menos de 24 horas.</p>
					</div>
				</div>

				<!-- Right Column: Form -->
				<div class="lg:col-span-3">
					<form id="contact-page-form" class="card-dark p-6 sm:p-8 space-y-5" novalidate>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="space-y-1.5">
								<label for="name" class="text-xs font-medium text-white/60 uppercase tracking-wider">
									Nombre completo <span class="text-cyan-400">*</span>
								</label>
								<input
									id="name"
									name="name"
									type="text"
									required
									placeholder="Tu nombre"
									class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-white/20 focus:outline-none focus:border-cyan-400/60 focus:bg-white/8 transition-all"
								/>
							</div>
							<div class="space-y-1.5">
								<label for="email" class="text-xs font-medium text-white/60 uppercase tracking-wider">
									Email <span class="text-cyan-400">*</span>
								</label>
								<input
									id="email"
									name="email"
									type="email"
									required
									placeholder="tu@email.com"
									class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-white/20 focus:outline-none focus:border-cyan-400/60 focus:bg-white/8 transition-all"
								/>
							</div>
						</div>

						<div class="space-y-1.5">
							<label for="subject" class="text-xs font-medium text-white/60 uppercase tracking-wider">
								Asunto
							</label>
							<input
								id="subject"
								name="subject"
								type="text"
								placeholder="Propuesta de proyecto / Consultoría"
								class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-white/20 focus:outline-none focus:border-cyan-400/60 focus:bg-white/8 transition-all"
							/>
						</div>

						<div class="space-y-1.5">
							<label for="message" class="text-xs font-medium text-white/60 uppercase tracking-wider">
								Mensaje <span class="text-cyan-400">*</span>
							</label>
							<textarea
								id="message"
								name="message"
								required
								rows="5"
								placeholder="Cuéntame sobre tu proyecto, objetivos y plazos..."
								class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-white/20 focus:outline-none focus:border-cyan-400/60 focus:bg-white/8 transition-all resize-none"
							></textarea>
						</div>

						<div id="contact-feedback" class="text-xs font-medium hidden p-3 rounded-lg"></div>

						<button type="submit" id="contact-submit-btn" class="btn-primary w-full justify-center">
							Enviar Mensaje →
						</button>
					</form>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script is:inline>
	(() => {
		const form = document.getElementById('contact-page-form');
		const feedback = document.getElementById('contact-feedback');
		const submitBtn = document.getElementById('contact-submit-btn');

		form?.addEventListener('submit', async (e) => {
			e.preventDefault();
			feedback.className = 'text-xs font-medium p-3 rounded-lg';
			feedback.classList.add('hidden');

			const data = {
				name: form.name.value,
				email: form.email.value,
				subject: form.subject?.value || '',
				message: form.message.value,
			};

			if (!data.name || !data.email || !data.message) {
				feedback.textContent = 'Por favor completa todos los campos requeridos.';
				feedback.classList.remove('hidden');
				feedback.classList.add('bg-red-500/20', 'text-red-300', 'border', 'border-red-500/30');
				return;
			}

			submitBtn.disabled = true;
			submitBtn.textContent = 'Enviando...';

			try {
				const res = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});
				const resData = await res.json();
				if (res.ok && resData.success) {
					feedback.textContent = '¡Mensaje enviado con éxito! Te responderé a la brevedad posible.';
					feedback.classList.remove('hidden');
					feedback.classList.add('bg-green-500/20', 'text-green-300', 'border', 'border-green-500/30');
					form.reset();
				} else {
					feedback.textContent = resData.error || 'Hubo un error al enviar el mensaje. Intenta de nuevo.';
					feedback.classList.remove('hidden');
					feedback.classList.add('bg-red-500/20', 'text-red-300', 'border', 'border-red-500/30');
				}
			} catch (err) {
				feedback.textContent = 'Error de conexión al enviar.';
				feedback.classList.remove('hidden');
				feedback.classList.add('bg-red-500/20', 'text-red-300', 'border', 'border-red-500/30');
			} finally {
				submitBtn.disabled = false;
				submitBtn.textContent = 'Enviar Mensaje →';
			}
		});
	})();
</script>
