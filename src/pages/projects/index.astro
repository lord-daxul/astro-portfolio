---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ProjectGrid from '../../components/projects/ProjectGrid.astro';
import { getProjects } from '../../lib/wordpress';

const projects = await getProjects(100).catch(() => []);
---

<BaseLayout
	title="Proyectos & WebApps"
	description="Portafolio de proyectos de software y WebApps creados por Raúl David Sánchez en Bogotá, Colombia: Astro, WordPress Headless, React, Next.js, Mobile (iOS/Android) y Cloudflare Workers."
	keywords={[
		'Proyectos WebApps Bogotá',
		'Portafolio Desarrollador Full Stack',
		'Proyectos WordPress Headless',
		'Aplicaciones Móviles React Native',
		'Desarrollo Web Astro Cloudflare',
		'Casos de estudio software Colombia',
	]}
>
	<div class="projects-page">
		<SectionHeader
			title="Proyectos, WebApps & Desarrollos"
			subtitle="Casos de estudio, aplicaciones web de alto rendimiento y soluciones digitales creadas con tecnologías modernas."
			align="left"
		/>

		<ProjectGrid
			projects={projects}
			basePath="/projects/"
			emptyMessage="Aún no hay proyectos publicados en WordPress o el servicio no está disponible temporalmente."
		/>
	</div>
</BaseLayout>

<style>
	.projects-page {
		padding-top: 1rem;
	}
</style>
