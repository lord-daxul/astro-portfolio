---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import ProjectGrid from '../../components/projects/ProjectGrid.astro';
import { getProjects } from '../../lib/wordpress';

const projects = await getProjects(100).catch(() => []);
---

<BaseLayout
	title="Proyectos"
	description="Catálogo de proyectos desarrollados por Raúl David Sánchez: WordPress Headless, Astro, React, APIs y aplicaciones web."
>
	<div class="projects-page">
		<SectionHeader
			title="Proyectos & Desarrollos"
			subtitle="Explora mis proyectos recientes, casos de estudio y herramientas desarrolladas."
			align="left"
		/>

		<ProjectGrid
			projects={projects}
			basePath="/projects/"
			emptyMessage="Aún no hay proyectos publicados en WordPress o el servicio no está disponible temporalmente."
		/>
	</div>
</BaseLayout>

<style>
	.projects-page {
		padding-top: 1rem;
	}
</style>
