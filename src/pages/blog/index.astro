---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/wordpress';

const fallbackPosts = [
	{
		id: '1',
		title: 'Construyendo APIs modernas con FastAPI y MongoDB',
		excerpt: 'Una guía práctica para crear APIs REST robustas usando Python, FastAPI y MongoDB como base de datos.',
		image: null,
		date: '2024-01-15',
		slug: 'fastapi-mongodb-guide',
		readTime: '8 min',
		categories: ['Backend', 'Python', 'FastAPI'],
	},
	{
		id: '2',
		title: 'React 18: Todo lo que necesitas saber',
		excerpt: 'Exploramos las nuevas características de React 18 incluyendo Concurrent Mode, Suspense y las nuevas hooks.',
		image: null,
		date: '2024-01-08',
		slug: 'react-18-features',
		readTime: '6 min',
		categories: ['Frontend', 'React'],
	},
	{
		id: '3',
		title: 'Docker para desarrolladores full-stack',
		excerpt: 'Aprende a containerizar tus aplicaciones web completas con Docker y Docker Compose de manera efectiva.',
		image: null,
		date: '2023-12-20',
		slug: 'docker-fullstack',
		readTime: '10 min',
		categories: ['DevOps', 'Docker'],
	},
	{
		id: '4',
		title: 'TailwindCSS: El framework que cambió mi flujo de trabajo',
		excerpt: 'Por qué adopté TailwindCSS y cómo transformó la manera en que construyo interfaces de usuario.',
		image: null,
		date: '2023-12-10',
		slug: 'tailwind-workflow',
		readTime: '5 min',
		categories: ['CSS', 'TailwindCSS'],
	},
];

let wpPosts = await getPosts(50).catch(() => []);
const posts = wpPosts.length > 0
	? wpPosts.map((p: any) => ({
			id: p.id,
			title: p.title,
			excerpt: p.excerpt ? p.excerpt.replace(/<[^>]*>/g, '').trim() : '',
			image: p.featuredImage?.node?.sourceUrl || null,
			date: p.date ? new Date(p.date).toISOString().split('T')[0] : '2024-01-15',
			slug: p.slug,
			readTime: '5 min',
			categories: p.categories || ['Tecnología'],
	  }))
	: fallbackPosts;

function formatDate(dateStr: string) {
	try {
		return new Date(dateStr).toLocaleDateString('es-ES', {
			day: 'numeric',
			month: 'long',
			year: 'numeric',
		});
	} catch {
		return dateStr;
	}
}
---

<BaseLayout
	title="Blog & Publicaciones"
	description="Artículos, tutoriales y reflexiones sobre desarrollo web, WordPress Headless, Astro, inteligencia artificial y arquitectura de software por Raúl David Sánchez."
>
	<!-- Banner -->
	<section class="relative py-20 bg-[#0b1020] overflow-hidden">
		<div class="absolute inset-0 grid-bg opacity-40 pointer-events-none"></div>
		<div class="absolute inset-0 hero-glow pointer-events-none"></div>

		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<span class="text-xs font-bold tracking-[0.2em] text-cyan-400 uppercase">Artículos & Tutoriales</span>
			<h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold mt-3 text-white">
				Blog & <span class="gradient-text">Publicaciones</span>
			</h1>
			<p class="text-white/60 max-w-2xl mx-auto text-base sm:text-lg mt-4 leading-relaxed">
				Notas técnicas, reflexiones y guías sobre desarrollo web, IA, rendimiento y mejores prácticas en la industria.
			</p>
		</div>
	</section>

	<!-- Posts Grid -->
	<section class="py-20 bg-[#0d1526] relative">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
				{
					posts.map((post) => (
						<article class="group card-dark overflow-hidden flex flex-col hover:-translate-y-2 transition-all duration-300">
							<div class="relative h-48 bg-gradient-to-br from-indigo-500/10 to-purple-500/10 overflow-hidden">
								{post.image ? (
									<img
										src={post.image}
										alt={post.title}
										class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
										loading="lazy"
									/>
								) : (
									<div class="w-full h-full flex items-center justify-center text-4xl">
										✍️
									</div>
								)}
								<div class="absolute inset-0 bg-gradient-to-t from-[#0b1020] via-transparent to-transparent opacity-60"></div>
								<span class="absolute top-3 right-3 text-xs font-medium px-2.5 py-1 rounded-full bg-[#0b1020]/80 text-white/60 border border-white/10">
									{post.readTime}
								</span>
							</div>

							<div class="p-6 flex flex-col gap-3.5 flex-1">
								<div class="flex items-center gap-1.5 text-xs text-white/40">
									<span>📅</span>
									<span>{formatDate(post.date)}</span>
								</div>

								<h2 class="font-display font-bold text-xl text-white group-hover:text-cyan-400 transition-colors leading-snug">
									<a href={`/blog/${post.slug}/`}>{post.title}</a>
								</h2>

								<p class="text-sm text-white/60 leading-relaxed flex-1 line-clamp-3">
									{post.excerpt}
								</p>

								<div class="pt-3 border-t border-white/5 flex items-center justify-between">
									<a
										href={`/blog/${post.slug}/`}
										class="text-xs font-bold text-cyan-400 hover:text-cyan-300 transition-colors"
									>
										Leer artículo →
									</a>
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
