---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import { getPostBySlug } from '../../lib/wordpress';

const slug = Astro.params.slug;
if (!slug) {
	return Astro.redirect('/404');
}

const post = await getPostBySlug(slug).catch(() => null);
if (!post) {
	return Astro.redirect('/404');
}

const img = post.featuredImage;

const postJsonLd = {
	'@type': 'BlogPosting',
	headline: post.title,
	description: post.excerpt || `Lee el artículo ${post.title} por Raúl David Sánchez.`,
	url: `https://rauldavid.com/blog/${post.slug}/`,
	image: img?.sourceUrl,
	datePublished: post.date,
	dateModified: post.modified || post.date,
	author: {
		'@type': 'Person',
		name: 'Raúl David Sánchez',
		url: 'https://rauldavid.com',
	},
	publisher: {
		'@type': 'Person',
		name: 'Raúl David Sánchez',
		url: 'https://rauldavid.com',
	},
	keywords: post.categories?.join(', '),
};
---

<BaseLayout
	title={post.title}
	description={post.excerpt || `Lee el artículo ${post.title} publicado por Raúl David Sánchez.`}
	image={img?.sourceUrl}
	type="article"
	publishedTime={post.date}
	modifiedTime={post.modified}
	jsonLd={postJsonLd}
>
	<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
		<!-- Breadcrumb -->
		<nav class="breadcrumb" aria-label="Migas de pan">
			<ol>
				<li><a href="/">Inicio</a></li>
				<li><a href="/blog/">Blog</a></li>
				<li aria-current="page">{post.title}</li>
			</ol>
		</nav>

		<article class="post-article">
			<header class="article-header">
				{
					post.date ? (
						<time class="article-date" datetime={post.date}>
							{new Date(post.date).toLocaleDateString('es-ES', {
								year: 'numeric',
								month: 'long',
								day: 'numeric',
							})}
						</time>
					) : null
				}

				<h1 class="article-title">{post.title}</h1>

				{post.excerpt ? <p class="article-lead">{post.excerpt}</p> : null}

				{
					post.categories?.length > 0 ? (
						<div class="article-tags" aria-label="Categorías">
							{post.categories.map((c) => (
								<Badge text={c} variant="default" />
							))}
						</div>
					) : null
				}
			</header>

			{
				img?.sourceUrl ? (
					<figure class="article-media">
						<img
							src={img.sourceUrl}
							alt={img.altText || post.title}
							width={img.width || 1200}
							height={img.height || 650}
							loading="eager"
							fetchpriority="high"
							decoding="async"
						/>
						{img.caption ? <figcaption>{img.caption}</figcaption> : null}
					</figure>
				) : null
			}

			{
				post.content ? (
					<div class="article-content-body wp-rendered-content" set:html={post.content} />
				) : null
			}

			<footer class="article-footer">
				<Button href="/blog/" variant="ghost">
					← Volver a todos los artículos
				</Button>
			</footer>
		</article>
	</div>
</BaseLayout>

<style>
	.breadcrumb {
		margin-bottom: 2rem;
		font-size: 0.875rem;
	}

	.breadcrumb ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
		color: var(--rd-muted);
	}

	.breadcrumb li:not(:last-child)::after {
		content: '/';
		margin-left: 0.5rem;
		color: var(--rd-ink);
	}

	.breadcrumb a {
		color: var(--rd-text-soft);
	}

	.breadcrumb a:hover {
		color: var(--rd-accent);
	}

	.post-article {
		max-width: 50rem;
		margin-inline: auto;
	}

	.article-header {
		margin-bottom: 2.5rem;
	}

	.article-date {
		display: block;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--rd-accent);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.75rem;
	}

	.article-title {
		font-size: clamp(2.25rem, 5vw, 3rem);
		font-weight: 800;
		line-height: 1.15;
		margin: 0 0 1rem;
		color: var(--rd-text);
	}

	.article-lead {
		font-size: 1.2rem;
		line-height: 1.6;
		color: var(--rd-text-soft);
		margin: 0 0 1.5rem;
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.article-media {
		margin: 0 0 3rem;
		border-radius: var(--rd-radius-lg);
		overflow: hidden;
		border: 1px solid var(--rd-ink);
		background: var(--rd-panel);
		box-shadow: var(--rd-shadow-md);
	}

	.article-media img {
		width: 100%;
		height: auto;
		display: block;
	}

	.article-content-body {
		font-size: 1.0625rem;
		line-height: 1.8;
		color: var(--rd-text);
		margin-bottom: 3.5rem;
	}

	.article-content-body :global(h2) {
		font-size: 1.75rem;
		font-weight: 800;
		margin-top: 2.5rem;
		margin-bottom: 1rem;
		color: var(--rd-text);
	}

	.article-content-body :global(h3) {
		font-size: 1.35rem;
		font-weight: 700;
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		color: var(--rd-text);
	}

	.article-content-body :global(p) {
		margin-bottom: 1.35rem;
	}

	.article-content-body :global(ul),
	.article-content-body :global(ol) {
		margin-bottom: 1.5rem;
		padding-left: 1.5rem;
	}

	.article-content-body :global(li) {
		margin-bottom: 0.5rem;
	}

	.article-content-body :global(pre) {
		margin-block: 1.75rem;
		padding: 1.25rem;
		border-radius: var(--rd-radius-md);
		background: var(--rd-panel);
		border: 1px solid var(--rd-ink);
		overflow-x: auto;
	}

	.article-content-body :global(blockquote) {
		margin-block: 1.75rem;
		padding-left: 1.25rem;
		border-left: 3px solid var(--rd-accent);
		color: var(--rd-text-soft);
		font-style: italic;
	}

	.article-footer {
		padding-top: 2rem;
		border-top: 1px solid var(--rd-ink);
	}
</style>
