---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Button from '../components/ui/Button.astro';

const principles = [
	{
		title: 'Vibe Coding & Velocidad de Iteración',
		description: 'Acelero el ciclo de vida de los productos combinando agentes de IA con arquitectura limpia, pasando de concepto a software funcional en tiempo récord.',
	},
	{
		title: 'Rendimiento Extremo (Core Web Vitals)',
		description: 'Construir para la web moderna significa priorizar la velocidad de carga (LCP < 1.2s), mínima sobrecarga de JavaScript y renderizado instantáneo en el Edge.',
	},
	{
		title: 'Ecosistema Multiplataforma (Web & Mobile)',
		description: 'Desarrollo soluciones unificadas: aplicaciones web reactivas y apps móviles nativas para iOS y Android con experiencias de usuario consistentes.',
	},
	{
		title: 'Arquitectura Desacoplada & CMS Headless',
		description: 'Separar el panel editorial (WordPress / WPGraphQL) de la capa de presentación (Astro) garantiza máxima seguridad, flexibilidad estética y escalabilidad.',
	},
];
---

<BaseLayout
	title="Sobre Mí"
	description="Conoce la trayectoria de Raúl David Sánchez: desarrollo Full Stack, WebApps, Mobile (iOS/Android), WordPress Headless y Vibe Coding con IA."
>
	<article class="about-page">
		<SectionHeader
			title="Sobre Mí"
			subtitle="Senior Full Stack Developer & AI Vibe Coder enfocado en crear productos digitales rápidos, escalables y multiplataforma."
			align="left"
		/>

		<div class="about-grid">
			<div class="about-story">
				<p>
					Hola, soy <strong>Raúl David Sánchez</strong>. Cuento con más de 8 años de experiencia en la industria tecnológica transformando retos complejos de negocio en productos de software eficientes y bien estructurados.
				</p>
				<p>
					Mi especialidad abarca el desarrollo de <strong>WebApps de alto rendimiento</strong> (Astro, React, TypeScript), aplicaciones móviles para <strong>iOS & Android</strong> (React Native / Expo) y arquitecturas desacopladas con <strong>WordPress Headless</strong> (WPGraphQL + Cloudflare Workers).
				</p>
				<p>
					Como pionero en la adopción de <strong>Vibe Coding</strong> y desarrollo asistido por agentes inteligentes de IA, integro herramientas de última generación en mis flujos diarios para optimizar tiempos de entrega sin sacrificar rigurosidad técnica, accesibilidad (WCAG 2.1 AA) ni mantenibilidad de código.
				</p>

				<div class="about-actions">
					<Button href="/projects/" variant="primary">Ver Proyectos</Button>
					<Button href="/cv/" variant="secondary">📄 Ver Currículum (CV)</Button>
					<Button href="/contacto/" variant="ghost">Hablemos de tu Proyecto →</Button>
				</div>
			</div>

			<aside class="about-sidebar">
				<div class="sidebar-card">
					<h3>Principios & Metodología</h3>
					<div class="principles-list">
						{
							principles.map((p) => (
								<div class="principle-item">
									<h4>{p.title}</h4>
									<p>{p.description}</p>
								</div>
							))
						}
					</div>
				</div>
			</aside>
		</div>
	</article>
</BaseLayout>

<style>
	.about-page {
		padding-top: 1rem;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1.3fr 0.9fr;
		gap: 3rem;
		margin-top: 2rem;
	}

	.about-story {
		font-size: 1.1rem;
		line-height: 1.7;
		color: var(--rd-text);
	}

	.about-story p {
		margin-bottom: 1.5rem;
	}

	.about-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2.5rem;
	}

	.about-sidebar {
		display: flex;
		flex-direction: column;
	}

	.sidebar-card {
		background: var(--rd-panel);
		border: 1px solid var(--rd-ink);
		border-radius: var(--rd-radius-lg);
		padding: 2rem;
		box-shadow: var(--rd-shadow-sm);
	}

	.sidebar-card h3 {
		font-size: 1.25rem;
		margin-bottom: 1.5rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--rd-ink);
	}

	.principles-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.principle-item h4 {
		font-size: 1.05rem;
		color: var(--rd-accent);
		margin-bottom: 0.35rem;
	}

	.principle-item p {
		font-size: 0.9375rem;
		color: var(--rd-text-soft);
		line-height: 1.55;
		margin: 0;
	}

	@media (max-width: 860px) {
		.about-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
