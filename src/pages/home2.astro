		<!-- Header Scroll, Mobile Menu & Theme Toggle Scripts -->
		<script is:inline>
			(() => {
				const header = document.getElementById('site-header');
				const mobileBtn = document.getElementById('mobile-menu-btn');
				const mobileMenu = document.getElementById('mobile-menu');
				const themeBtn = document.getElementById('theme-toggle-btn');
				const sunIcon = document.getElementById('sun-icon');
				const moonIcon = document.getElementById('moon-icon');

				// Scroll behavior for navbar
				const handleScroll = () => {
					if (window.scrollY > 20) {
						header.classList.add('bg-[#0b1020]/90', 'backdrop-blur-md', 'border-b', 'border-white/5', 'shadow-xl');
						header.classList.remove('bg-transparent');
					} else {
						header.classList.remove('bg-[#0b1020]/90', 'backdrop-blur-md', 'border-b', 'border-white/5', 'shadow-xl');
						header.classList.add('bg-transparent');
					}
				};
				window.addEventListener('scroll', handleScroll);
				handleScroll();

				// Mobile menu toggle
				mobileBtn?.addEventListener('click', () => {
					mobileMenu?.classList.toggle('hidden');
				});

				// Theme toggle
				const updateThemeIcons = () => {
					const isLight = document.body.classList.contains('light');
					if (isLight) {
						sunIcon?.classList.add('hidden');
						moonIcon?.classList.remove('hidden');
					} else {
						sunIcon?.classList.remove('hidden');
						moonIcon?.classList.add('hidden');
					}
				};

				themeBtn?.addEventListener('click', () => {
					document.body.classList.toggle('light');
					document.documentElement.classList.toggle('light');
					const isLight = document.body.classList.contains('light');
					localStorage.setItem('theme', isLight ? 'light' : 'dark');
					updateThemeIcons();
				});
				updateThemeIcons();

				// Contact form submit
				const form = document.getElementById('docker-form');
				const feedback = document.getElementById('form-feedback');
				const submitBtn = document.getElementById('submit-btn');

				form?.addEventListener('submit', async (e) => {
					e.preventDefault();
					feedback.className = 'text-xs font-medium p-3 rounded-lg';
					feedback.classList.add('hidden');

					const data = {
						name: form.name.value,
						email: form.email.value,
						message: form.message.value,
					};

					submitBtn.disabled = true;
					submitBtn.textContent = 'Enviando...';

					try {
						const res = await fetch('/api/contact', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify(data),
						});
						const resData = await res.json();
						if (res.ok && resData.success) {
							feedback.textContent = '¡Mensaje enviado! Te responderé a la brevedad.';
							feedback.classList.remove('hidden');
							feedback.classList.add('bg-green-500/20', 'text-green-300', 'border', 'border-green-500/30');
							form.reset();
						} else {
							feedback.textContent = resData.error || 'Hubo un error al enviar. Intenta de nuevo.';
							feedback.classList.remove('hidden');
							feedback.classList.add('bg-red-500/20', 'text-red-300', 'border', 'border-red-500/30');
						}
					} catch (err) {
						feedback.textContent = 'Error de conexión al enviar.';
						feedback.classList.remove('hidden');
						feedback.classList.add('bg-red-500/20', 'text-red-300', 'border', 'border-red-500/30');
					} finally {
						submitBtn.disabled = false;
						submitBtn.textContent = 'Enviar mensaje';
					}
				});
			})();
		</script>
	</body>
</html>
