---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects, getPosts } from '../lib/wordpress';
import type { Project } from '../types/project';

const techStack = [
	{ name: 'Astro', icon: '🚀', color: 'from-orange-500/10 to-red-500/10', border: 'border-orange-500/20' },
	{ name: 'React', icon: '⚛️', color: 'from-blue-500/10 to-cyan-500/10', border: 'border-blue-500/20' },
	{ name: 'Next.js', icon: '▲', color: 'from-white/5 to-white/10', border: 'border-white/10' },
	{ name: 'TypeScript', icon: 'TS', color: 'from-blue-600/10 to-blue-400/10', border: 'border-blue-500/20' },
	{ name: 'Node.js', icon: '🟢', color: 'from-green-500/10 to-emerald-500/10', border: 'border-green-500/20' },
	{ name: 'TailwindCSS', icon: '🌊', color: 'from-cyan-500/10 to-teal-500/10', border: 'border-cyan-500/20' },
	{ name: 'WordPress Headless', icon: '🌐', color: 'from-blue-700/10 to-cyan-600/10', border: 'border-blue-500/20' },
	{ name: 'WPGraphQL', icon: '⚡', color: 'from-pink-500/10 to-purple-500/10', border: 'border-pink-500/20' },
	{ name: 'React Native (iOS/Android)', icon: '📱', color: 'from-blue-400/10 to-indigo-400/10', border: 'border-blue-400/20' },
	{ name: 'Cloudflare Workers', icon: '☁️', color: 'from-amber-500/10 to-orange-500/10', border: 'border-amber-500/20' },
	{ name: 'Python & FastAPI', icon: '🐍', color: 'from-yellow-500/10 to-blue-500/10', border: 'border-yellow-500/20' },
	{ name: 'PostgreSQL', icon: '🐘', color: 'from-blue-700/10 to-blue-400/10', border: 'border-blue-600/20' },
	{ name: 'Docker', icon: '🐳', color: 'from-blue-500/10 to-sky-500/10', border: 'border-blue-400/20' },
	{ name: 'AI Vibe Coding', icon: '🧠', color: 'from-purple-500/10 to-cyan-500/10', border: 'border-purple-500/20' },
	{ name: 'Core Web Vitals', icon: '🎯', color: 'from-emerald-500/10 to-teal-500/10', border: 'border-emerald-500/20' },
	{ name: 'Git & GitHub CI/CD', icon: '🔀', color: 'from-orange-500/10 to-red-500/10', border: 'border-orange-500/20' },
];

const fallbackProjects: Project[] = [
	{
		id: 'p-1',
		title: 'Daxulfolio Modern Headless',
		slug: 'daxulfolio-headless',
		excerpt: 'Portfolio personal ultra optimizado en Cloudflare Workers con WordPress Headless, Astro y TailwindCSS.',
		technologies: ['Astro', 'WordPress', 'WPGraphQL', 'Cloudflare Workers'],
		categories: ['Headless CMS', 'Astro'],
		isFeatured: true,
	},
	{
		id: 'p-2',
		title: 'E-Commerce & Headless Catalog',
		slug: 'ecommerce-headless',
		excerpt: 'Plataforma de comercio electrónico de alta conversión con panel de administración y pagos integrados.',
		technologies: ['Next.js', 'Stripe', 'PostgreSQL', 'Docker'],
		categories: ['E-Commerce', 'Full Stack'],
		isFeatured: true,
	},
	{
		id: 'p-3',
		title: 'Task & Workflow Mobile App',
		slug: 'task-mobile-app',
		excerpt: 'Aplicación móvil multiplataforma para iOS y Android con sincronización en tiempo real.',
		technologies: ['React Native', 'Expo', 'Node.js', 'Mobile APIs'],
		categories: ['Mobile', 'iOS / Android'],
		isFeatured: true,
	},
	{
		id: 'p-4',
		title: 'API Serverless Microservices',
		slug: 'api-serverless',
		excerpt: 'Arquitectura de microservicios en el Edge con autenticación segura y documentación automática.',
		technologies: ['Cloudflare Workers', 'TypeScript', 'Resend API'],
		categories: ['Cloud & Edge', 'APIs'],
		isFeatured: true,
	},
];

let projects = await getProjects(8).catch(() => []);
if (projects.length === 0) {
	projects = fallbackProjects;
}

let posts = await getPosts(4).catch(() => []);
---

<BaseLayout
	title="Home 2 (Docker Style)"
	description="Versión interactiva del portafolio inspirada en el diseño visual de portafolio docker: Cyber-Dark, Glassmorphism, TailwindCSS y conexión a WordPress."
>
	<!-- Hero Section (Docker Portafolio Style) -->
	<section id="inicio" class="hero-docker relative min-h-[85vh] flex items-center overflow-hidden">
		<div class="absolute inset-0 grid-bg opacity-40 pointer-events-none"></div>
		<div class="absolute inset-0 hero-glow pointer-events-none"></div>
		<div class="glow-orb glow-orb-1 pointer-events-none"></div>
		<div class="glow-orb glow-orb-2 pointer-events-none"></div>

		<div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
				<!-- Left Column: Copy & Actions -->
				<div class="lg:col-span-7 space-y-6">
					<div class="inline-flex items-center gap-2">
						<span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse"></span>
						<span class="text-xs font-bold tracking-[0.2em] text-cyan-400 uppercase">
							📍 Bogotá, Colombia · Desarrollador Full-Stack & AI Vibe Coder
						</span>
					</div>

					<h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight text-white tracking-tight">
						Hola, Soy <span class="gradient-text">Raúl David Sánchez</span>
					</h1>

					<p class="text-base sm:text-lg text-white/70 leading-relaxed max-w-xl">
						Transformo ideas en soluciones digitales funcionales y atractivas. Combino lógica,
						diseño y creatividad para crear aplicaciones web de alto rendimiento (WebApps),
						<strong>WordPress Headless</strong> en el Edge y aplicaciones móviles para <strong>iOS & Android</strong>.
					</p>

					<blockquote class="border-l-2 border-cyan-400 pl-4 text-white/60 italic text-sm">
						"Siempre aprendiendo, siempre construyendo con la mejor arquitectura y velocidad."
					</blockquote>

					<div class="flex flex-wrap items-center gap-3 pt-2">
						<a href="#portfolio" class="btn-primary">
							Portafolio →
						</a>
						<a href="/cv/" class="btn-outline">
							📄 Ver / Descargar CV
						</a>
						<a href="#contacto" class="btn-outline">
							Contáctame
						</a>
					</div>

					<div class="flex items-center gap-4 pt-4">
						<a
							href="https://github.com/daxul"
							target="_blank"
							rel="noopener noreferrer"
							class="social-btn"
							aria-label="GitHub"
						>
							<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
						</a>
						<a
							href="https://linkedin.com"
							target="_blank"
							rel="noopener noreferrer"
							class="social-btn"
							aria-label="LinkedIn"
						>
							<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
						</a>
						<a
							href="mailto:contacto@rauldavid.com"
							class="social-btn"
							aria-label="Email"
						>
							<svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
						</a>
					</div>
				</div>

				<!-- Right Column: Avatar & Floating Badges -->
				<div class="lg:col-span-5 flex justify-center lg:justify-end">
					<div class="relative">
						<!-- Glow background -->
						<div class="absolute inset-0 rounded-3xl bg-gradient-to-br from-cyan-500/20 to-indigo-500/20 blur-2xl scale-105 pointer-events-none"></div>
						
						<div class="relative w-72 h-80 sm:w-80 sm:h-96 lg:w-88 lg:h-[26rem] rounded-3xl overflow-hidden border border-white/10 glow-cyan bg-[#0f172a]">
							<img
								src="/img/raul-david-sanchez.webp"
								alt="Fotografía de Raúl David Sánchez"
								class="w-full h-full object-cover object-top"
								loading="eager"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-[#0b1020]/70 via-transparent to-transparent"></div>
						</div>

						<!-- Floating Badge 1 (Bottom Left) -->
						<div class="floating-badge floating-badge-bottom animate-float">
							<div class="flex items-center gap-2">
								<span class="w-2.5 h-2.5 rounded-full bg-green-400 animate-pulse"></span>
								<span class="text-xs font-semibold text-white/90">Disponible para proyectos</span>
							</div>
						</div>

						<!-- Floating Badge 2 (Top Right) -->
						<div class="floating-badge floating-badge-top">
							<div class="text-[11px] text-white/60">Proyectos Completados</div>
							<div class="text-lg font-extrabold text-cyan-400">+30</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Technologies Section (From Docker Technologies.js) -->
	<section id="tecnologias" class="py-20 bg-[#0d1526] relative overflow-hidden">
		<div class="absolute inset-0 grid-bg opacity-20 pointer-events-none"></div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-12">
				<span class="text-xs font-bold tracking-[0.2em] text-cyan-400 uppercase">Stack Técnico</span>
				<h2 class="text-3xl sm:text-4xl font-bold mt-2 text-white">
					Tecnologías que <span class="gradient-text">domino</span>
				</h2>
				<p class="text-white/60 max-w-lg mx-auto text-sm mt-2">
					Herramientas y frameworks modernos con los que construyo soluciones robustas, escalables y veloces.
				</p>
			</div>

			<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 gap-4">
				{
					techStack.map((tech) => (
						<div class={`tech-card bg-gradient-to-br ${tech.color} border ${tech.border}`}>
							<span class="text-2xl">{tech.icon}</span>
							<span class="text-xs font-semibold text-white/80 text-center">
								{tech.name}
							</span>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Portfolio Section (From Docker Portfolio.js) -->
	<section id="portfolio" class="py-24 bg-[#0b1020] relative">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-14">
				<span class="text-xs font-bold tracking-[0.2em] text-cyan-400 uppercase">Mi Trabajo</span>
				<h2 class="text-3xl sm:text-4xl font-bold mt-2 text-white">
					Proyectos <span class="gradient-text">destacados</span>
				</h2>
				<p class="text-white/60 max-w-lg mx-auto text-sm mt-2">
					Selección de aplicaciones web, arquitecturas headless y casos de estudio en producción.
				</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
				{
					projects.map((project) => (
						<article class="card-dark overflow-hidden flex flex-col group">
							<div class="relative h-48 bg-gradient-to-br from-cyan-500/10 to-indigo-500/10 overflow-hidden">
								{project.featuredImage?.sourceUrl ? (
									<img
										src={project.featuredImage.sourceUrl}
										alt={project.featuredImage.altText || project.title}
										class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
										loading="lazy"
									/>
								) : (
									<div class="w-full h-full flex items-center justify-center">
										<span class="text-4xl font-mono text-cyan-400/40">{'</>'}</span>
									</div>
								)}
								<div class="absolute inset-0 bg-gradient-to-t from-[#0b1020] via-transparent to-transparent opacity-60"></div>
							</div>

							<div class="p-5 flex flex-col gap-3 flex-1">
								<h3 class="font-bold text-white group-hover:text-cyan-400 transition-colors text-lg">
									{project.title}
								</h3>
								<p class="text-sm text-white/60 leading-relaxed flex-1 line-clamp-3">
									{project.excerpt ? project.excerpt.replace(/<[^>]*>/g, '') : 'Aplicación web desarrollada con tecnologías modernas.'}
								</p>

								<div class="flex flex-wrap gap-1.5">
									{(project.technologies || []).slice(0, 4).map((tech) => (
										<span class="tag">{tech}</span>
									))}
								</div>

								<div class="flex items-center gap-3 pt-2">
									<a
										href={`/projects/${project.slug}/`}
										class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors"
									>
										Ver detalles →
									</a>
									{project.projectUrl ? (
										<a
											href={project.projectUrl}
											target="_blank"
											rel="noopener"
											class="text-xs text-white/50 hover:text-white transition-colors"
										>
											En vivo ↗
										</a>
									) : null}
								</div>
							</div>
						</article>
					))
				}
			</div>

			<div class="text-center mt-12">
				<a href="/projects/" class="btn-outline">
					Explorar todos los proyectos →
				</a>
			</div>
		</div>
	</section>

	<!-- Blog Section (From Docker Blog.js) -->
	{
		posts && posts.length > 0 ? (
			<section id="blog" class="py-24 bg-[#0d1526] relative">
				<div class="absolute inset-0 grid-bg opacity-20 pointer-events-none"></div>
				<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="text-center mb-14">
						<span class="text-xs font-bold tracking-[0.2em] text-cyan-400 uppercase">Artículos & Blog</span>
						<h2 class="text-3xl sm:text-4xl font-bold mt-2 text-white">
							Últimas <span class="gradient-text">publicaciones</span>
						</h2>
						<p class="text-white/60 max-w-lg mx-auto text-sm mt-2">
							Comparto lo que aprendo sobre desarrollo web, inteligencia artificial y arquitectura de software.
						</p>
					</div>

					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
						{posts.map((post: any) => (
							<article class="card-dark overflow-hidden flex flex-col group">
								<div class="relative h-44 bg-gradient-to-br from-indigo-500/10 to-purple-500/10 overflow-hidden">
									{post.featuredImage?.node?.sourceUrl ? (
										<img
											src={post.featuredImage.node.sourceUrl}
											alt={post.title}
											class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
											loading="lazy"
										/>
									) : (
										<div class="w-full h-full flex items-center justify-center text-3xl">
											✍️
										</div>
									)}
									<div class="absolute inset-0 bg-gradient-to-t from-[#0b1020] via-transparent to-transparent opacity-60"></div>
								</div>

								<div class="p-5 flex flex-col gap-2.5 flex-1">
									<time class="text-xs text-white/40">
										{post.date ? new Date(post.date).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Reciente'}
									</time>
									<h3 class="font-bold text-white group-hover:text-cyan-400 transition-colors line-clamp-2">
										{post.title}
									</h3>
									<p class="text-sm text-white/60 flex-1 line-clamp-3">
										{post.excerpt ? post.excerpt.replace(/<[^>]*>/g, '') : ''}
									</p>
									<a href={`/blog/${post.slug}/`} class="text-xs font-semibold text-cyan-400 pt-2 hover:underline">
										Leer artículo →
									</a>
								</div>
							</article>
						))}
					</div>
				</div>
			</section>
		) : null
	}

	<!-- Contact Section (From Docker Contact.js) -->
	<section id="contacto" class="py-24 bg-[#0b1020] relative overflow-hidden">
		<div class="absolute inset-0 grid-bg opacity-20 pointer-events-none"></div>
		<div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-14">
				<span class="text-xs font-bold tracking-[0.2em] text-cyan-400 uppercase">Hablemos</span>
				<h2 class="text-3xl sm:text-4xl font-bold mt-2 text-white">
					¿Tienes un <span class="gradient-text">proyecto</span> en mente?
				</h2>
				<p class="text-white/60 max-w-lg mx-auto text-sm mt-2">
					Estoy disponible para proyectos de desarrollo Full Stack, WebApps, aplicaciones móviles y consultoría técnica.
				</p>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-5 gap-10 items-start">
				<!-- Left info -->
				<div class="lg:col-span-2 space-y-6">
					<div class="space-y-4">
						<div class="flex items-center gap-3 text-white/70">
							<div class="p-2.5 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400">
								📧
							</div>
							<div>
								<div class="text-xs text-white/40">Email</div>
								<a href="mailto:contacto@rauldavid.com" class="text-sm font-semibold text-white hover:text-cyan-400">
									contacto@rauldavid.com
								</a>
							</div>
						</div>
						<div class="flex items-center gap-3 text-white/70">
							<div class="p-2.5 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400">
								📍
							</div>
							<div>
								<div class="text-xs text-white/40">Ubicación</div>
								<div class="text-sm font-semibold text-white">Bogotá, Colombia (Remoto Global)</div>
							</div>
						</div>
					</div>

					<div class="card-dark p-5 border-cyan-500/20 bg-cyan-500/5">
						<div class="flex items-center gap-2 mb-1">
							<span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
							<span class="text-sm font-bold text-white">Disponible ahora</span>
						</div>
						<p class="text-xs text-white/50 m-0">Tiempo promedio de respuesta: menos de 24 horas.</p>
					</div>
				</div>

				<!-- Right form -->
				<div class="lg:col-span-3">
					<form id="docker-contact-form" class="card-dark p-6 sm:p-8 space-y-4" novalidate>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="space-y-1">
								<label for="c-name" class="text-xs font-semibold text-white/60 uppercase tracking-wider">Nombre</label>
								<input
									id="c-name"
									name="name"
									type="text"
									required
									placeholder="Tu nombre"
									class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-cyan-400"
								/>
							</div>
							<div class="space-y-1">
								<label for="c-email" class="text-xs font-semibold text-white/60 uppercase tracking-wider">Email</label>
								<input
									id="c-email"
									name="email"
									type="email"
									required
									placeholder="tu@email.com"
									class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-cyan-400"
								/>
							</div>
						</div>

						<div class="space-y-1">
							<label for="c-message" class="text-xs font-semibold text-white/60 uppercase tracking-wider">Mensaje</label>
							<textarea
								id="c-message"
								name="message"
								rows="5"
								required
								placeholder="Cuéntame sobre tu proyecto..."
								class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-white/30 focus:outline-none focus:border-cyan-400 resize-none"
							></textarea>
						</div>

						<div id="c-status" class="text-sm font-semibold hidden p-3 rounded-lg"></div>

						<button type="submit" id="c-btn" class="btn-primary w-full justify-center">
							Enviar Mensaje →
						</button>
					</form>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<script is:inline>
	(() => {
		const form = document.getElementById('docker-contact-form');
		const statusBox = document.getElementById('c-status');
		const btn = document.getElementById('c-btn');

		if (!form || !statusBox || !btn) return;

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			statusBox.className = 'text-sm font-semibold p-3 rounded-lg';
			statusBox.classList.add('hidden');

			const formData = new FormData(form);
			const payload = {
				name: formData.get('name')?.toString() || '',
				email: formData.get('email')?.toString() || '',
				message: formData.get('message')?.toString() || '',
			};

			if (!payload.name || !payload.email || !payload.message) {
				statusBox.textContent = 'Por favor completa todos los campos requeridos.';
				statusBox.classList.remove('hidden');
				statusBox.classList.add('bg-red-500/20', 'text-red-300', 'border', 'border-red-500/30');
				return;
			}

			btn.disabled = true;
			btn.textContent = 'Enviando...';

			try {
				const res = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(payload),
				});
				const result = await res.json();
				if (res.ok && result.success) {
					statusBox.textContent = '¡Mensaje enviado con éxito! Me pondré en contacto pronto.';
					statusBox.classList.remove('hidden');
					statusBox.classList.add('bg-green-500/20', 'text-green-300', 'border', 'border-green-500/30');
					form.reset();
				} else {
					statusBox.textContent = result.error || 'Ocurrió un error al enviar el mensaje.';
					statusBox.classList.remove('hidden');
					statusBox.classList.add('bg-red-500/20', 'text-red-300', 'border', 'border-red-500/30');
				}
			} catch (err) {
				statusBox.textContent = 'Error de conexión. Intenta nuevamente.';
				statusBox.classList.remove('hidden');
				statusBox.classList.add('bg-red-500/20', 'text-red-300', 'border', 'border-red-500/30');
			} finally {
				btn.disabled = false;
				btn.textContent = 'Enviar Mensaje →';
			}
		});
	})();
</script>

