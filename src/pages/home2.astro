							Home Clásico ↗
						</a>
					</nav>

					<div class="flex items-center gap-2">
						<button id="theme-toggle-btn" class="p-2 rounded-lg text-white/60 hover:text-cyan-400 hover:bg-white/5 transition-all" aria-label="Cambiar tema">
							<svg id="sun-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
							<svg id="moon-icon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
						</button>

						<a href="/cv/" class="flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-semibold bg-[#2979FF] text-white hover:bg-[#2979FF]/80 transition-all shadow-lg shadow-[#2979FF]/20">
							Ver CV
						</a>

						<button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-white/60 hover:text-white hover:bg-white/5 transition-all" aria-label="Abrir menú">
