---
export const prerender = false;

import { getProjects, getPosts } from '../lib/wordpress';
import '../styles/global.css';

const specialtiesAndSkills = [
	{
		title: 'Desarrollo de WebApps & Full Stack',
		description: 'Ingeniería de aplicaciones web modernas, reactivas y ultrarrápidas utilizando Astro, React, Next.js, TypeScript y Tailwind CSS.',
		tags: ['WebApps', 'Astro', 'React', 'Next.js', 'TypeScript', 'Node.js', 'Tailwind CSS'],
		icon: '⚡',
		color: 'from-blue-500/10 to-cyan-500/10',
		border: 'border-blue-500/20',
	},
	{
		title: 'Desarrollo Móvil (iOS & Android)',
		description: 'Creación de aplicaciones móviles multiplataforma nativas y fluidas, con sincronización de datos en tiempo real y almacenamiento offline.',
		tags: ['iOS', 'Android', 'React Native', 'Expo', 'Cross-Platform', 'Mobile APIs'],
		icon: '📱',
		color: 'from-cyan-500/10 to-indigo-500/10',
		border: 'border-cyan-500/20',
	},
	{
		title: 'Vibe Coding & AI Engineering',
		description: 'Desarrollo acelerado mediante agentes autónomos de IA, prototipado instantáneo de ideas a producción, integración de LLMs y automatizaciones.',
		tags: ['Vibe Coding', 'AI Agents', 'LLMs', 'Prompt Engineering', 'Automatización'],
		icon: '🧠',
		color: 'from-purple-500/10 to-pink-500/10',
		border: 'border-purple-500/20',
	},
	{
		title: 'WordPress Headless & CMS Moderno',
		description: 'Arquitecturas desacopladas con WPGraphQL y ACF Pro para entregar paneles editoriales intuitivos y frontends de máxima velocidad.',
		tags: ['WordPress Headless', 'WPGraphQL', 'ACF Pro', 'PHP', 'APIs REST'],
		icon: '🌐',
		color: 'from-teal-500/10 to-emerald-500/10',
		border: 'border-teal-500/20',
	},
	{
		title: 'Cloud, Edge & Serverless',
		description: 'Despliegues globales en el Edge con Cloudflare Workers, microservicios serverless, latencia ultrabaja y entrega de emails con Resend.',
		tags: ['Cloudflare Workers', 'Edge Computing', 'Wrangler', 'Serverless', 'Resend API'],
		icon: '☁️',
		color: 'from-amber-500/10 to-orange-500/10',
		border: 'border-amber-500/20',
	},
	{
		title: 'Rendimiento Extremo & Accesibilidad (a11y)',
		description: 'Optimización obsesiva de Core Web Vitals (LCP < 1.2s), navegación por teclado, contraste estricto y cumplimiento WCAG 2.1 AA.',
		tags: ['Core Web Vitals', 'LCP < 1.2s', 'WCAG 2.1 AA', 'SEO Técnico'],
		icon: '🎯',
		color: 'from-emerald-500/10 to-cyan-500/10',
		border: 'border-emerald-500/20',
	},
];

const techStack = [
	{ name: 'React', icon: '⚛️', color: 'from-blue-500/10 to-cyan-500/10', border: 'border-blue-500/20' },
	{ name: 'Next.js', icon: '▲', color: 'from-white/5 to-white/10', border: 'border-white/10' },
	{ name: 'TypeScript', icon: 'TS', color: 'from-blue-600/10 to-blue-400/10', border: 'border-blue-500/20' },
	{ name: 'Node.js', icon: '🟢', color: 'from-green-500/10 to-emerald-500/10', border: 'border-green-500/20' },
	{ name: 'Python', icon: '🐍', color: 'from-yellow-500/10 to-blue-500/10', border: 'border-yellow-500/20' },
	{ name: 'FastAPI', icon: '⚡', color: 'from-teal-500/10 to-green-500/10', border: 'border-teal-500/20' },
	{ name: 'MongoDB', icon: '🍃', color: 'from-green-600/10 to-green-400/10', border: 'border-green-500/20' },
	{ name: 'PostgreSQL', icon: '🐘', color: 'from-blue-700/10 to-blue-400/10', border: 'border-blue-600/20' },
	{ name: 'Docker', icon: '🐳', color: 'from-blue-500/10 to-sky-500/10', border: 'border-blue-400/20' },
	{ name: 'TailwindCSS', icon: '🌊', color: 'from-cyan-500/10 to-teal-500/10', border: 'border-cyan-500/20' },
	{ name: 'React Native', icon: '📱', color: 'from-blue-400/10 to-indigo-400/10', border: 'border-blue-400/20' },
	{ name: 'Git', icon: '🔀', color: 'from-orange-500/10 to-red-500/10', border: 'border-orange-500/20' },
];

const fallbackProjects = [
	{
		id: 1,
		title: 'Daxulfolio',
		description: 'Portfolio personal moderno construido con React, TailwindCSS y FastAPI.',
		image: null,
		technologies: ['React', 'TailwindCSS', 'FastAPI', 'MongoDB'],
		link: '#',
		github: 'https://github.com/lord-daxul/astro-portfolio',
	},
	{
		id: 2,
		title: 'E-Commerce Platform',
		description: 'Plataforma de comercio electrónico con panel de administración y pagos integrados.',
		image: null,
		technologies: ['Next.js', 'Stripe', 'PostgreSQL', 'Docker'],
		link: '#',
		github: '#',
	},
	{
		id: 3,
		title: 'Task Manager App',
		description: 'Aplicación de gestión de tareas con colaboración en tiempo real.',
		image: null,
		technologies: ['React Native', 'Node.js', 'Socket.io', 'MongoDB'],
		link: '#',
		github: '#',
	},
	{
		id: 4,
		title: 'API REST Microservices',
		description: 'Arquitectura de microservicios con autenticación JWT y documentación automática.',
		image: null,
		technologies: ['Python', 'FastAPI', 'Docker', 'Redis'],
		link: '#',
		github: '#',
	},
];

let wpProjects = await getProjects(8).catch(() => []);
const displayProjects = wpProjects.length > 0
	? wpProjects.map((p) => ({
			id: p.id,
			title: p.title,
			description: p.excerpt ? p.excerpt.replace(/<[^>]*>/g, '').trim() : 'Proyecto desarrollado con tecnologías modernas.',
			image: p.featuredImage?.sourceUrl || null,
			technologies: p.technologies || ['React', 'TailwindCSS'],
			link: `/projects/${p.slug}/`,
			github: p.repositoryUrl || '#',
	  }))
	: fallbackProjects;

let wpPosts = await getPosts(4).catch(() => []);
const fallbackPosts = [
	{
		id: 1,
		title: 'Construyendo APIs modernas con FastAPI y MongoDB',
		excerpt: 'Una guía práctica para crear APIs REST robustas usando Python, FastAPI y MongoDB como base de datos.',
		image: null,
		date: '2024-01-15',
		slug: 'fastapi-mongodb-guide',
		readTime: '8 min',
	},
	{
		id: 2,
		title: 'React 18: Todo lo que necesitas saber',
		excerpt: 'Exploramos las nuevas características de React 18 incluyendo Concurrent Mode, Suspense y las nuevas hooks.',
		image: null,
		date: '2024-01-08',
		slug: 'react-18-features',
		readTime: '6 min',
	},
	{
		id: 3,
		title: 'Docker para desarrolladores full-stack',
		excerpt: 'Aprende a containerizar tus aplicaciones web completas con Docker y Docker Compose de manera efectiva.',
		image: null,
		date: '2023-12-20',
		slug: 'docker-fullstack',
		readTime: '10 min',
	},
	{
		id: 4,
		title: 'TailwindCSS: El framework que cambió mi flujo de trabajo',
		excerpt: 'Por qué adopté TailwindCSS y cómo transformó la manera en que construyo interfaces de usuario.',
		image: null,
		date: '2023-12-10',
		slug: 'tailwind-workflow',
		readTime: '5 min',
	},
];

const displayPosts = wpPosts.length > 0
	? wpPosts.map((p: any) => ({
			id: p.id,
			title: p.title,
			excerpt: p.excerpt ? p.excerpt.replace(/<[^>]*>/g, '').trim() : '',
			image: p.featuredImage?.node?.sourceUrl || null,
			date: p.date ? new Date(p.date).toISOString().split('T')[0] : '2024-01-15',
			slug: p.slug,
			readTime: '5 min',
	  }))
	: fallbackPosts;

function formatDate(dateStr: string) {
	try {
		return new Date(dateStr).toLocaleDateString('es-ES', {
			day: 'numeric',
			month: 'long',
			year: 'numeric',
		});
	} catch {
		return dateStr;
	}
}
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Daxulfolio | Raúl David - Senior Full Stack & AI Vibe Coder</title>
		<meta name="description" content="Raúl David - Senior Full Stack Developer & AI Vibe Coder en Bogotá, Colombia. WebApps, WordPress Headless, iOS/Android y Cloudflare Workers." />
		<meta name="keywords" content="desarrollador full-stack, WebApps, React, Node.js, portfolio, WordPress Headless, Bogota Colombia" />
		<meta name="author" content="Raúl David" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			(() => {
				const saved = localStorage.getItem('theme');
				if (saved === 'light') {
					document.documentElement.classList.add('light');
					document.body?.classList.add('light');
				}
			})();
		</script>
	</head>

	<body class="bg-[#0b1020] text-white font-sans antialiased transition-colors duration-300">
