---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';

const specialties = [
	{
		title: 'Desarrollo de WebApps & Full Stack',
		description: 'Ingeniería de aplicaciones web modernas, reactivas y ultrarrápidas utilizando Astro, React, Next.js, TypeScript y Tailwind CSS.',
		tags: ['WebApps', 'Astro', 'React', 'Next.js', 'TypeScript', 'Node.js', 'Tailwind CSS'],
		icon: '⚡',
	},
	{
		title: 'Desarrollo Móvil (iOS & Android)',
		description: 'Creación de aplicaciones móviles multiplataforma nativas y fluidas, con sincronización de datos en tiempo real y almacenamiento offline.',
		tags: ['iOS', 'Android', 'React Native', 'Expo', 'Cross-Platform', 'Mobile APIs'],
		icon: '📱',
	},
	{
		title: 'Vibe Coding & AI Engineering',
		description: 'Desarrollo acelerado mediante agentes autónomos de IA, prototipado instantáneo de ideas a producción, integración de LLMs y automatizaciones.',
		tags: ['Vibe Coding', 'AI Agents', 'LLMs', 'Prompt Engineering', 'Automatización'],
		icon: '🧠',
	},
	{
		title: 'WordPress Headless & CMS Moderno',
		description: 'Arquitecturas desacopladas con WPGraphQL y ACF Pro para entregar paneles editoriales intuitivos y frontends de máxima velocidad.',
		tags: ['WordPress Headless', 'WPGraphQL', 'ACF Pro', 'PHP', 'APIs REST'],
		icon: '🌐',
	},
	{
		title: 'Cloud, Edge & Serverless',
		description: 'Despliegues globales en el Edge con Cloudflare Workers, microservicios serverless, latencia ultrabaja y entrega de emails con Resend.',
		tags: ['Cloudflare Workers', 'Edge Computing', 'Wrangler', 'Serverless', 'Resend API'],
		icon: '☁️',
	},
	{
		title: 'Rendimiento Extremo & Accesibilidad (a11y)',
		description: 'Optimización obsesiva de Core Web Vitals (LCP < 1.2s), navegación por teclado, contraste estricto y cumplimiento WCAG 2.1 AA.',
		tags: ['Core Web Vitals', 'LCP < 1.2s', 'WCAG 2.1 AA', 'SEO Técnico'],
		icon: '🎯',
	},
];

const categoryStacks = [
	{
		category: 'Frontend & WebApps',
		items: [
			{ name: 'Astro', icon: '🚀', desc: 'Framework web orientado a contenido y Zero JS.' },
			{ name: 'React', icon: '⚛️', desc: 'Interfaces reactivas, componentización y ecosistema moderno.' },
			{ name: 'Next.js', icon: '▲', desc: 'SSR, App Router y optimización de rendimiento.' },
			{ name: 'TypeScript', icon: 'TS', desc: 'Tipado estricto, seguridad y código autodocumentado.' },
			{ name: 'Tailwind CSS', icon: '🌊', desc: 'Diseño responsivo, tokens CSS y utilidades modernas.' },
		],
	},
	{
		category: 'Backend & APIs',
		items: [
			{ name: 'Node.js', icon: '🟢', desc: 'Servicios en tiempo real, APIs REST y microservicios.' },
			{ name: 'Python', icon: '🐍', desc: 'Automatizaciones, backend y scripts de procesamiento de datos.' },
			{ name: 'FastAPI', icon: '⚡', desc: 'APIs asíncronas de alto rendimiento con documentación OpenAPI.' },
			{ name: 'PostgreSQL', icon: '🐘', desc: 'Bases de datos relacionales robustas y escalables.' },
			{ name: 'MongoDB', icon: '🍃', desc: 'Bases de datos orientadas a documentos NoSQL.' },
		],
	},
	{
		category: 'Mobile & Multiplataforma',
		items: [
			{ name: 'React Native', icon: '📱', desc: 'Desarrollo nativo unificado para iOS y Android.' },
			{ name: 'Expo', icon: '🛠️', desc: 'Entorno ágil de compilación y despliegue móvil.' },
			{ name: 'Mobile APIs', icon: '🔌', desc: 'Integración de push notifications, geolocalización y offline storage.' },
		],
	},
	{
		category: 'Cloud, Edge & Infraestructura',
		items: [
			{ name: 'Cloudflare Workers', icon: '☁️', desc: 'Servicios serverless con computación global en el Edge.' },
			{ name: 'Docker', icon: '🐳', desc: 'Contenedores, entornos reproducibles y microservicios.' },
			{ name: 'Git & GitHub CI/CD', icon: '🔀', desc: 'Control de versiones, pipelines automatizados y despliegues continuos.' },
			{ name: 'Resend API', icon: '📧', desc: 'Infraestructura serverless de entrega de correos transaccionales.' },
		],
	},
	{
		category: 'CMS & Arquitectura Headless',
		items: [
			{ name: 'WordPress Headless', icon: '🌐', desc: 'Gestión editorial desacoplada de alto rendimiento.' },
			{ name: 'WPGraphQL', icon: '⚡', desc: 'Capa API GraphQL para WordPress flexible y tipada.' },
			{ name: 'ACF Pro & Custom Post Types', icon: '🧩', desc: 'Modelado de datos avanzado y personalizado.' },
		],
	},
	{
		category: 'AI Engineering & Vibe Coding',
		items: [
			{ name: 'Agentes Autónomos', icon: '🧠', desc: 'Automatización y aceleración del ciclo de ingeniería de software.' },
			{ name: 'Integración LLM', icon: '🤖', desc: 'Implementación de modelos generativos y embeddings.' },
			{ name: 'Prompt Engineering', icon: '💡', desc: 'Diseño de instrucciones de alta precisión para tareas de código.' },
		],
	},
];
---

<BaseLayout
	title="Stack Técnico & Habilidades"
	description="Stack tecnológico, frameworks, herramientas y especialidades de ingeniería dominadas por Raúl David Sánchez — Senior Full Stack Developer en Bogotá, Colombia."
>
	<!-- Stack Hero Banner -->
	<section class="relative py-20 bg-[#0b1020] overflow-hidden">
		<div class="absolute inset-0 grid-bg opacity-40 pointer-events-none"></div>
		<div class="absolute inset-0 hero-glow pointer-events-none"></div>

		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<span class="text-xs font-bold tracking-[0.2em] text-cyan-400 uppercase">Tecnología & Arquitectura</span>
			<h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold mt-3 text-white">
				Stack Técnico & <span class="gradient-text">Especialidades</span>
			</h1>
			<p class="text-white/60 max-w-2xl mx-auto text-base sm:text-lg mt-4 leading-relaxed">
				Herramientas, lenguajes, frameworks y soluciones en la nube con las que diseño y construyo productos digitales robustos, rápidos y escalables.
			</p>
		</div>
	</section>

	<!-- Especialidades de Ingeniería -->
	<section class="py-20 bg-[#0d1526] relative border-t border-white/5">
		<div class="absolute inset-0 grid-bg opacity-20 pointer-events-none"></div>
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-14">
				<span class="text-xs font-semibold tracking-[0.2em] text-cyan-400 uppercase">Capacidades Clave</span>
				<h2 class="section-title text-3xl md:text-4xl font-display font-bold mt-2 text-white">
					Disciplinas de <span class="gradient-text">Ingeniería</span>
				</h2>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{
					specialties.map((item) => (
						<div class="group card-dark p-7 flex flex-col justify-between hover:-translate-y-2 hover:border-cyan-400/50 hover:shadow-2xl hover:shadow-cyan-500/10 transition-all duration-300">
							<div>
								<div class="flex items-center justify-between gap-3 mb-5">
									<span class="text-3xl p-3 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 group-hover:scale-110 group-hover:border-cyan-400/40 transition-transform duration-300">
										{item.icon}
									</span>
									<span class="w-2.5 h-2.5 rounded-full bg-cyan-400/40 group-hover:bg-cyan-400 group-hover:animate-pulse transition-colors"></span>
								</div>

								<h3 class="font-display font-bold text-xl text-white group-hover:text-cyan-400 transition-colors mb-3 leading-snug">
									{item.title}
								</h3>

								<p class="text-sm text-white/60 leading-relaxed mb-6">
									{item.description}
								</p>
							</div>

							<div class="flex flex-wrap gap-1.5 pt-4 border-t border-white/5">
								{item.tags.map((tag) => (
									<span class="tag">{tag}</span>
								))}
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Stack por Categorías -->
	<section class="py-24 bg-[#0b1020] relative">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-16">
				<span class="text-xs font-semibold tracking-[0.2em] text-cyan-400 uppercase">Herramientas & Frameworks</span>
				<h2 class="section-title text-3xl md:text-4xl font-display font-bold mt-2 text-white">
					Ecosistema <span class="gradient-text">Tecnológico</span>
				</h2>
			</div>

			<div class="space-y-12">
				{
					categoryStacks.map((group) => (
						<div class="card-dark p-6 sm:p-8">
							<h3 class="font-display font-bold text-xl text-cyan-400 mb-6 flex items-center gap-2 border-b border-white/5 pb-3">
								<span>⚡</span> {group.category}
							</h3>
							<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
								{group.items.map((tool) => (
									<div class="p-4 rounded-xl bg-white/5 border border-white/5 hover:border-cyan-400/30 transition-all flex items-start gap-3.5">
										<span class="text-2xl mt-0.5">{tool.icon}</span>
										<div>
											<div class="font-semibold text-white text-sm">{tool.name}</div>
											<p class="text-xs text-white/50 mt-1 m-0 leading-relaxed">{tool.desc}</p>
										</div>
									</div>
								))}
							</div>
						</div>
					))
				}
			</div>

			<!-- CTA Bottom -->
			<div class="text-center mt-16 p-10 card-dark bg-gradient-to-r from-cyan-500/10 via-[#0b1020] to-indigo-500/10">
				<h3 class="text-2xl font-bold text-white mb-2">¿Quieres ver estas tecnologías en acción?</h3>
				<p class="text-white/60 text-sm max-w-xl mx-auto mb-6">
					Explora los proyectos reales que he construido o contáctame para hablar sobre tu próximo desafío técnico.
				</p>
				<div class="flex flex-wrap justify-center gap-4">
					<a href="/projects/" class="btn-primary">
						Ver Proyectos →
					</a>
					<a href="/contacto/" class="btn-outline">
						Hablemos
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
