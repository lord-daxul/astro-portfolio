---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';

const techEcosystem = [
	{
		number: '01',
		category: 'Frontend & WebApps',
		icon: '⚛️',
		description: 'Arquitectura de cliente, interfaces interactivas y sistemas de diseño de alto rendimiento.',
		cards: [
			{
				title: 'Core UI & Modern Frameworks',
				enfoque: 'Arquitectura de cliente, interfaces reactivas y renderizado moderno.',
				descripcion: 'Desarrollo de interfaces interactivas, accesibles y modulares con tipado estricto y Server-Side Rendering (SSR/SSG).',
				stack: ['React', 'Next.js', 'TypeScript', 'JavaScript (ES6+)', 'HTML5 / CSS3'],
			},
			{
				title: 'Diseño de Sistemas & UI Engineering',
				enfoque: 'Experiencia visual, diseño responsivo y componentes reusables.',
				descripcion: 'Maquetación rápida y consistente mediante Utility-First CSS, librerías accesibles basadas en Radix y micro-interacciones fluidas.',
				stack: ['Tailwind CSS', 'Shadcn UI', 'Radix UI', 'Framer Motion', 'Lucide Icons'],
			},
			{
				title: 'Gestión de Estado, Datos & Tooling',
				enfoque: 'Sincronización de datos, formularios robustos y optimización de bundle.',
				descripcion: 'Manejo de estado global predecible, caché de datos de servidor y validación estricta de formularios.',
				stack: ['TanStack Query (React Query)', 'Zustand', 'React Hook Form', 'Zod', 'Vite'],
			},
		],
	},
	{
		number: '02',
		category: 'Backend & APIs',
		icon: '⚡',
		description: 'Servicios escalables, APIs tipadas, persistencia de datos y microservicios concurrentes.',
		cards: [
			{
				title: 'Servidores & Lógica de Negocio',
				enfoque: 'Servicios escalables, arquitecturas orientadas a servicios y microservicios.',
				descripcion: 'Creación de backends eficientes, manejo de concurrencia y construcción de APIs RESTful y GraphQL bien documentadas.',
				stack: ['Node.js', 'Express', 'NestJS', 'PHP (Moderno)', 'REST APIs', 'GraphQL'],
			},
			{
				title: 'Bases de Datos & ORMs',
				enfoque: 'Persistencia de datos, modelado relacional y NoSQL.',
				descripcion: 'Diseño de esquemas eficientes, migraciones, optimización de consultas y capas de abstracción tipadas.',
				stack: ['PostgreSQL', 'MySQL', 'MongoDB', 'Prisma ORM', 'Drizzle ORM', 'Redis'],
			},
			{
				title: 'Autenticación & Integraciones',
				enfoque: 'Seguridad, pasarelas y servicios de terceros.',
				descripcion: 'Implementación de flujos de autenticación seguros (OAuth, JWT), pasarelas de pago y consumo de webhooks.',
				stack: ['NextAuth / Auth.js', 'JWT', 'Stripe API', 'Webhooks', 'CORS & Security Headers'],
			},
		],
	},
	{
		number: '03',
		category: 'Mobile & Multiplataforma',
		icon: '📱',
		description: 'Desarrollo móvil nativo con base de código única, PWAs y publicación en tiendas.',
		cards: [
			{
				title: 'Desarrollo Híbrido & Cross-Platform',
				enfoque: 'Aplicaciones móviles nativas con una base de código única.',
				descripcion: 'Creación de apps para iOS y Android con rendimiento cuasi-nativo y sincronización de estado.',
				stack: ['React Native', 'Expo', 'TypeScript', 'NativeWind (Tailwind for RN)'],
			},
			{
				title: 'Progressive Web Apps (PWA)',
				enfoque: 'Experiencias web instalables y offline-first.',
				descripcion: 'Implementación de Service Workers, caché avanzado en cliente y adaptación responsiva a dispositivos móviles.',
				stack: ['PWA Manifest', 'Service Workers', 'Workbox', 'IndexedDB', 'Push Notifications'],
			},
			{
				title: 'Publicación & Distribución',
				enfoque: 'Empaquetado, pipelines de build y consolas de distribución.',
				descripcion: 'Configuración de builds de producción, resolución de dependencias nativas y despliegue en tiendas de aplicaciones.',
				stack: ['Google Play Console', 'EAS Build (Expo)', 'Android SDK / App Bundles (.aab)'],
			},
		],
	},
	{
		number: '04',
		category: 'Cloud, Edge & Infraestructura',
		icon: '☁️',
		description: 'Despliegues globales serverless en el Edge, bases de datos administradas y CI/CD automatizado.',
		cards: [
			{
				title: 'Edge Computing & Serverless',
				enfoque: 'Ejecución de código a nivel global y baja latencia.',
				descripcion: 'Despliegue de microservicios, APIs y workers distribuidos en el edge para cómputo inmediato sin servidor dedicado.',
				stack: ['Cloudflare Workers', 'Cloudflare Pages / KV', 'Vercel Serverless', 'Wrangler CLI'],
			},
			{
				title: 'Cloud Databases & BaaS',
				enfoque: 'Infraestructura de datos administrada y tiempo real.',
				descripcion: 'Plataformas backend integradas con base de datos, almacenamiento de objetos y reglas de seguridad automáticas.',
				stack: ['Supabase', 'Firebase / Firestore', 'Cloudflare R2 / S3', 'Neon (Serverless Postgres)'],
			},
			{
				title: 'CI/CD, DevOps & Versionado',
				enfoque: 'Automatización de flujos de entrega y control de código.',
				descripcion: 'Pipelines de integración y despliegue continuo, contenedores ligeros y control de versiones profesional.',
				stack: ['Git', 'GitHub Actions', 'Docker', 'DNS Management / Cloudflare CDN'],
			},
		],
	},
	{
		number: '05',
		category: 'CMS & Arquitectura Headless (WordPress Pro)',
		icon: '🌐',
		description: 'Desarrollo a medida en WordPress, WooCommerce y arquitecturas desacopladas ultra rápidas.',
		cards: [
			{
				title: 'Desarrollo a Medida en WordPress & WooCommerce',
				enfoque: 'Programación nativa, snippets personalizados y lógica e-commerce compleja.',
				descripcion: 'Creación y personalización avanzada de plugins, hooks, filtros y reglas complejas de checkout/envío en WooCommerce.',
				stack: ['WordPress Core', 'WooCommerce', 'PHP / OOP', 'Custom Post Types (CPT)', 'ACF Pro'],
			},
			{
				title: 'Headless WordPress & Decoupled CMS',
				enfoque: 'WordPress como backend de contenidos consumido por frontends modernos.',
				descripcion: 'Exposición de endpoints y datos estructurados para ser renderizados a máxima velocidad en Next.js/React.',
				stack: ['WP REST API', 'WPGraphQL', 'Next.js ISR / SSR', 'Webhook Triggers (On-demand Revalidation)'],
			},
			{
				title: 'Performance, Seguridad & Optimización CMS',
				enfoque: 'Core Web Vitals, caching agresivo y hardening.',
				descripcion: 'Auditoría de velocidad, compresión de assets, cache a nivel de servidor/edge y mitigación de vulnerabilidades.',
				stack: ['Redis Object Cache', 'WP-CLI', 'Cloudflare Cache Rules', 'Database Optimization', 'Security Hardening'],
			},
		],
	},
	{
		number: '06',
		category: 'AI Engineering & Vibe Coding',
		icon: '🧠',
		description: 'Integración de LLMs generativos, desarrollo asistido por agentes de IA y automatizaciones inteligentes.',
		cards: [
			{
				title: 'Integración de LLMs & APIs de IA',
				enfoque: 'Inclusión de modelos de lenguaje en aplicaciones web.',
				descripcion: 'Consumo de APIs generativas, orquestación de prompts, streaming de respuestas y parsing estructurado de datos (JSON Mode).',
				stack: ['Google Gemini API', 'Google AI Studio', 'OpenAI API', 'LangChain / Vercel AI SDK'],
			},
			{
				title: 'Flujos de Vibe Coding & Tooling Acelerado por IA',
				enfoque: 'Productividad extrema en desarrollo asistido por IA.',
				descripcion: 'Arquitectura guiada por IA, generación de código contextual, prototipado acelerado y debugging asistido en tiempo real.',
				stack: ['Cursor IDE', 'Claude Dev / Copilot', 'Prompt Engineering', 'Context Window Optimization', 'Automated Refactoring'],
			},
			{
				title: 'Automatización Inteligente & Web Scraping',
				enfoque: 'Extracción de datos no estructurados y pipelines de automatización.',
				descripcion: 'Scrapers automatizados y microservicios que procesan, limpian y estructuran información externa para APIs privadas.',
				stack: ['Puppeteer / Cheerio', 'Automated Cron Workers', 'Structured Data Extraction', 'n8n / Webhooks'],
			},
		],
	},
];
---

<BaseLayout
	title="Stack Técnico & Ecosistema Tecnológico"
	description="Herramientas, frameworks y arquitectura técnica dominadas por Raúl David Sánchez: Frontend, Backend, Mobile, Cloud Serverless, WordPress Headless e IA Engineering."
>
	<!-- Stack Hero Banner -->
	<section class="relative py-20 bg-[#0b1020] overflow-hidden">
		<div class="absolute inset-0 grid-bg opacity-40 pointer-events-none"></div>
		<div class="absolute inset-0 hero-glow pointer-events-none"></div>

		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<span class="text-xs font-bold tracking-[0.2em] text-cyan-400 uppercase">Herramientas & Frameworks</span>
			<h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold mt-3 text-white">
				Ecosistema <span class="gradient-text">Tecnológico</span>
			</h1>
			<p class="text-white/60 max-w-2xl mx-auto text-base sm:text-lg mt-4 leading-relaxed">
				Stack técnico de producción, herramientas y arquitectura de software que domino para construir soluciones digitales rápidas, escalables y seguras.
			</p>
		</div>
	</section>

	<!-- Ecosistema Tecnológico por Categorías -->
	<section class="py-20 bg-[#0d1526] relative">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
			{
				techEcosystem.map((cat) => (
					<div class="space-y-8">
						<!-- Categoría Header -->
						<div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-white/10 pb-5">
							<div>
								<div class="flex items-center gap-2.5 mb-1.5">
									<span class="text-xs font-mono font-bold text-cyan-400 px-2 py-0.5 rounded bg-cyan-500/10 border border-cyan-500/20">
										{cat.number}
									</span>
									<span class="text-xl">{cat.icon}</span>
									<h2 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-tight">
										{cat.category}
									</h2>
								</div>
								<p class="text-sm text-white/50 m-0 max-w-2xl">{cat.description}</p>
							</div>
						</div>

						<!-- Grid de 3 Cards por Categoría -->
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
							{cat.cards.map((card) => (
								<div class="group card-dark p-7 flex flex-col justify-between hover:-translate-y-2 hover:border-cyan-400/50 hover:shadow-2xl hover:shadow-cyan-500/10 transition-all duration-300">
									<div>
										<!-- Enfoque Badge -->
										<div class="mb-4">
											<span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 px-2.5 py-1 rounded-md inline-block leading-normal">
												Enfoque: {card.enfoque}
											</span>
										</div>

										<!-- Title -->
										<h3 class="font-display font-bold text-lg text-white group-hover:text-cyan-400 transition-colors mb-3 leading-snug">
											{card.title}
										</h3>

										<!-- Description -->
										<p class="text-sm text-white/60 leading-relaxed mb-6">
											{card.descripcion}
										</p>
									</div>

									<!-- Stack Tags -->
									<div class="pt-4 border-t border-white/5">
										<div class="text-[11px] text-white/40 uppercase tracking-widest font-mono mb-2">Stack Tecnológico</div>
										<div class="flex flex-wrap gap-1.5">
											{card.stack.map((tech) => (
												<span class="tag">{tech}</span>
											))}
										</div>
									</div>
								</div>
							))}
						</div>
					</div>
				))
			}

			<!-- CTA Bottom -->
			<div class="text-center mt-20 p-10 card-dark bg-gradient-to-r from-cyan-500/10 via-[#0b1020] to-indigo-500/10 border border-cyan-500/20">
				<h3 class="text-2xl font-display font-bold text-white mb-2">¿Tienes un desafío técnico o un proyecto en mente?</h3>
				<p class="text-white/60 text-sm max-w-xl mx-auto mb-6">
					Explora los proyectos reales que he construido o contáctame para diseñar la mejor arquitectura para tu producto digital.
				</p>
				<div class="flex flex-wrap justify-center gap-4">
					<a href="/projects/" class="btn-primary">
						Ver Portafolio →
					</a>
					<a href="/contacto/" class="btn-outline">
						Contactar Ahora
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
